<!-- Generated by {{ project.generator_name }}. DO NOT EDIT. -->
<!-- Detail-page child section accordion (one instance per child section;
     replaces the former in-page include, issue #468 W4). -->
{% raw %}<script lang="ts" generics="T extends { id: string }">
	import { goto } from '$app/navigation';
	import * as AlertDialog from '#lib/components/ui/alert-dialog/index.js';
	import * as DropdownMenu from '#lib/components/ui/dropdown-menu/index.js';
	import { apiDelete } from '#lib/api/client.ts';
	import { toast } from 'svelte-sonner';
	import * as m from '#lib/paraglide/messages.js';

	interface Props<T extends { id: string }> {
		items: T[];
		label: string;
		moduleName: string;
		domain: string;
		pathSegment: string;
		parentId: string;
		displayField: string | null;
		childSectionTid: string;
		addBtnTid: string;
		actionsTid: string;
		actionsMenuTid: string;
		actionEditTid: string;
		actionDeleteTid: string;
		manageBtnTid: string;
		hasChildren: boolean;
		deleteDialogTid: string;
		deleteDialogConfirmTid: string;
		menuActions: { action: string; label: string }[];
		primaryActions: { action: string; label: string }[];
		confirmDelete: boolean;
		onRefresh: () => Promise<void>;
		onManage: (domain: string, pathSegment: string, childId: string) => void;
	}

	let {
		items,
		label,
		moduleName,
		domain,
		pathSegment,
		parentId,
		displayField,
		childSectionTid,
		addBtnTid,
		actionsTid,
		actionsMenuTid,
		actionEditTid,
		actionDeleteTid,
		manageBtnTid,
		hasChildren,
		deleteDialogTid,
		deleteDialogConfirmTid,
		menuActions,
		primaryActions,
		confirmDelete,
		onRefresh,
		onManage,
	}: Props<T> = $props();

	// One accordion section per component instance (the parent page no
	// longer keeps a shared expanded-set); sections start closed.
	let expanded = $state(false);
	let deleteId = $state<string | null>(null);

	const labelFor = (item: T): string =>
		displayField
			? ((item as Record<string, unknown>)[displayField] as string | undefined) ?? item.id
			: item.id;

	async function performDelete(childId: string) {
		try {
			await apiDelete(`/${domain}/${pathSegment}/${childId}`);
			toast.success(m.common_child_deleted());
			await onRefresh();
		} catch (e) {
			toast.error(m.common_delete_failed({ error: (e as Error).message }));
		}
	}

	function confirmDeleteItem() {
		const childId = deleteId;
		deleteId = null;
		if (childId !== null) void performDelete(childId);
	}
</script>

<div class="border rounded-lg overflow-hidden">
	<!-- Collapsible header -->
	<button
		class="flex w-full items-center justify-between px-4 py-3 text-sm font-medium bg-muted/50 hover:bg-muted transition-colors"
		onclick={() => (expanded = !expanded)}
		data-testid={childSectionTid}
		type="button"
	>
		<span class="flex items-center gap-2">
			<span>{label}</span>
			<span class="text-xs text-muted-foreground font-normal">
				({items.length})
			</span>
		</span>
		<span class="text-muted-foreground">
			{expanded ? '▼' : '▶'}
		</span>
	</button>

	<!-- Expanded content -->
	{#if expanded}
		<div class="p-4 space-y-3">
			<!-- Add button -->
			<div class="flex justify-end">
				<button
					class="inline-flex items-center gap-1 rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent transition-colors"
					onclick={() => goto(`/${domain}/${pathSegment}/new?parent_id=${parentId}`)}
					data-testid={addBtnTid}
					type="button"
				>
					+ Add
				</button>
			</div>

			<!-- Items list -->
			{#if items.length === 0}
				<p class="text-sm text-muted-foreground text-center py-4">No items yet.</p>
			{:else}
				<ul class="divide-y divide-border rounded-md border">
					{#each items as child (child.id)}
						<li class="flex items-center justify-between px-3 py-2 text-sm">
							<span class="truncate text-foreground">
								{labelFor(child)}
							</span>
							<div class="flex shrink-0 items-center gap-1 ml-2">
								{#if menuActions.length > 0}
								<!-- ux-rules (#299): primary open/manage stays inline (the
									 Manage → link below); Edit/Delete tier into the
									 per-item actions menu, Delete behind the plan's
									 confirmation. -->
								<DropdownMenu.Root>
									<DropdownMenu.Trigger
										class="rounded px-2 py-1 text-xs hover:bg-accent transition-colors"
										data-testid={actionsTid}
									>
										{m.common_actions()}
									</DropdownMenu.Trigger>
									<DropdownMenu.Portal>
										<DropdownMenu.Content data-testid={actionsMenuTid} class="w-40">
											{#each menuActions as item}
												{#if item.action === 'edit'}
												<DropdownMenu.Item
													data-testid={actionEditTid}
													onclick={() => goto(`/${domain}/${pathSegment}/${child.id}/edit`)}
												>
													{m.common_edit()}
												</DropdownMenu.Item>
												{:else if item.action === 'delete'}
												<DropdownMenu.Item
													class="text-destructive data-[highlighted]:text-destructive"
													data-testid={actionDeleteTid}
													onclick={() => { if (confirmDelete) { deleteId = child.id; } else { void performDelete(child.id); } }}
												>
													{m.common_delete()}
												</DropdownMenu.Item>
												{/if}
											{/each}
										</DropdownMenu.Content>
									</DropdownMenu.Portal>
								</DropdownMenu.Root>
								{:else}
								<button
									class="rounded px-2 py-1 text-xs hover:bg-accent transition-colors"
									onclick={() => goto(`/${domain}/${pathSegment}/${child.id}/edit`)}
									type="button"
								>
									Edit
								</button>
								<button
									class="rounded px-2 py-1 text-xs text-destructive hover:bg-destructive/10 transition-colors"
									onclick={() => performDelete(child.id)}
									type="button"
								>
									Delete
								</button>
								{/if}
								{#if hasChildren}
								<button
									class="rounded px-2 py-1 text-xs hover:bg-accent transition-colors"
									onclick={() => onManage(domain, pathSegment, child.id)}
									data-testid={manageBtnTid}
									type="button"
								>
									Manage →
								</button>
								{/if}
							</div>
						</li>
					{/each}
				</ul>
			{/if}
		</div>
	{/if}
	{#if confirmDelete}
	<AlertDialog.Root open={deleteId !== null} onOpenChange={(v) => { if (!v) deleteId = null; }}>
		<AlertDialog.Content data-testid={deleteDialogTid}>
			<AlertDialog.Header>
				<AlertDialog.Title>{m.common_confirm_delete_title({ entity: label })}</AlertDialog.Title>
				<AlertDialog.Description>
					{m.common_confirm_delete_description()}
				</AlertDialog.Description>
			</AlertDialog.Header>
			<AlertDialog.Footer>
				<AlertDialog.Cancel>{m.common_cancel()}</AlertDialog.Cancel>
				<AlertDialog.Action
					onclick={confirmDeleteItem}
					data-testid={deleteDialogConfirmTid}
					class="bg-destructive text-destructive-foreground hover:bg-destructive/90"
				>
					{m.common_delete()}
				</AlertDialog.Action>
			</AlertDialog.Footer>
		</AlertDialog.Content>
	</AlertDialog.Root>
	{/if}
</div>
{% endraw %}
