					Found {data.total} result{data.total === 1 ? '' : 's'} for &ldquo;{data.query}&rdquo;
				{:else}
					Showing {displayRows.length} result{displayRows.length === 1 ? '' : 's'}
				{/if}
			</span>
{% endraw %}
{% else %}
{% raw %}
			<span>Showing {displayRows.length} result{displayRows.length === 1 ? '' : 's'}</span>
{% endraw %}
{% endif %}
{% raw %}
			<div class="flex gap-2">
				<Button
					variant="outline"
					size="sm"
					disabled={data.page === 0}
					onclick={() => handlePageChange(data.page - 1)}
				>
					{m.common_previous()}
				</Button>
				<Button
					variant="outline"
					size="sm"
					disabled={data.items.length < data.pageSize}
					onclick={() => handlePageChange(data.page + 1)}
				>
					{m.common_next()}
				</Button>
			</div>
		</div>
	{/if}
{% endraw %}
</div>{% if ux_actions and has_delete %}{% raw %}
<AlertDialog.Root open={deleteTarget !== null} onOpenChange={(v) => { if (!v) deleteTarget = null; }}>
	<AlertDialog.Content data-testid="{% endraw %}{{ tid.delete_dialog }}{% raw %}">
		<AlertDialog.Header>
			<AlertDialog.Title>{m.common_confirm_delete_title({ entity: '{% endraw %}{{ entity_name }}{% raw %}' })}</AlertDialog.Title>
			<AlertDialog.Description>
				{m.common_confirm_delete_description()}
			</AlertDialog.Description>
		</AlertDialog.Header>
		<AlertDialog.Footer>
			<AlertDialog.Cancel>{m.common_cancel()}</AlertDialog.Cancel>
			<AlertDialog.Action
				onclick={() => performDelete(deleteTarget as Record<string, unknown>)}
				disabled={deleting}
				data-testid="{% endraw %}{{ tid.delete_dialog_confirm }}{% raw %}"
				class="bg-destructive text-destructive-foreground hover:bg-destructive/90"
			>
				{deleting ? m.common_deleting() : m.common_delete()}
			</AlertDialog.Action>
		</AlertDialog.Footer>
	</AlertDialog.Content>
</AlertDialog.Root>{% endraw %}{% endif %}{% if ux.timeline %}
<style>
	/* Timeline collection layout (issue #298): vertical rail using theme
	   tokens from app.css — no new component dependency. */
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.timeline-item {
		display: grid;
		grid-template-columns: 10rem 1.25rem minmax(0, 1fr) auto;
		column-gap: 0.75rem;
		padding: 0.75rem 0;
	}

	.timeline-time {
		text-align: right;
		white-space: nowrap;
		padding-top: 0.125rem;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}

	.timeline-rail {
		position: relative;
	}

	.timeline-rail::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--border);
	}

	.timeline-rail::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 0.5rem;
		transform: translateX(-50%);
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 9999px;
		background: var(--muted);
		border: 1px solid var(--border);
	}

	.timeline-item:first-child .timeline-rail::before {
		top: 0.5rem;
	}

	.timeline-item:last-child .timeline-rail::before {
		bottom: calc(100% - 0.5rem);
	}

	.timeline-body {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.timeline-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.timeline-title a {
		color: inherit;
	}

	.timeline-title a:hover {
		text-decoration: underline;
	}

	.timeline-meta-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.75rem;
	}

	.timeline-meta {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}

	.timeline-actions {
		align-self: start;
	}

	.timeline-item.timeline-inactive {
		opacity: 0.6;
	}

	@media (max-width: 640px) {
		.timeline-item {
			grid-template-columns: 1.25rem minmax(0, 1fr) auto;
		}

		.timeline-time {
			grid-column: 2;
			grid-row: 1;
			text-align: left;
		}

		.timeline-rail {
			grid-row: 1 / 4;
		}

		.timeline-body {
			grid-column: 2;
		}

		.timeline-actions {
			grid-column: 2;
		}
	}
</style>
{% endif %}
