{# Timeline collections keep their fixed DESC date order (issue #306 v1): no sort buttons, no aria-sort. If/when IFML parity lands, a RenderColumn-style per-entry contract would mirror the table's header-button pattern — deliberately not built here (ledger item, #291). #}
{% raw %}
		<ol class="timeline" data-testid="{% endraw %}{{ tid.timeline }}{% raw %}">
			{#each displayRowsSorted as row}
				<li class="timeline-item" data-testid="{% endraw %}{{ tid.timeline_item }}{% raw %}"{% endraw %}{% if ux.inactive_shading %}{% raw %} class:timeline-inactive={isInactiveRow(row as Record<string, unknown>)}{% endraw %}{% endif %}{% raw %}>
					<time class="timeline-time">{formatDate((row as Record<string, unknown>)[orderKey])}</time>
					<div class="timeline-rail" aria-hidden="true"></div>
					<div class="timeline-body">
						<h3 class="timeline-title">
							<a href={`${basePath}/${row['id']}`}>{String((row as Record<string, unknown>)[titleKey] ?? (row as Record<string, unknown>)['id'])}</a>
						</h3>
						{#if previewColumns.length > 0}
							<div class="timeline-meta-list">
								{#each previewColumns as col}
									{@const value = (row as Record<string, unknown>)[col.key]}
									<span class="timeline-meta" data-testid="{% endraw %}{{ tid.timeline_meta }}{% raw %}">{col.label}: {% endraw %}{% raw %}
									{#if value === null || value === undefined}
										{formatValue(value)}
									{:else if isBooleanField(value)}
										<Badge variant={value ? 'default' : 'secondary'}>
											{formatValue(value)}
										</Badge>
									{:else if col.display === 'chip'}
										<Badge variant={toneFor(col, value)} data-testid="{% endraw %}{{ tid.chip }}{% raw %}">
											{formatValue(value)}
										</Badge>
									{:else if col.display === 'copy-chip'}
										{#if col.truncateTooltip}
											<Tooltip.Root>
												<Tooltip.Trigger
													class="inline-flex max-w-[12rem] items-center gap-1 rounded-md border bg-muted/40 px-1.5 py-0.5 font-mono text-xs"
													data-testid="{% endraw %}{{ tid.copy }}{% raw %}"
													onclick={(e) => { e.stopPropagation(); copyValue(value); }}
												>
													{truncate(value, 8)}
												</Tooltip.Trigger>
												<Tooltip.Content>{String(value)}</Tooltip.Content>
											</Tooltip.Root>
										{:else}
											<button
												class="inline-flex max-w-[12rem] items-center gap-1 rounded-md border bg-muted/40 px-1.5 py-0.5 font-mono text-xs"
												data-testid="{% endraw %}{{ tid.copy }}{% raw %}"
												onclick={(e) => { e.stopPropagation(); copyValue(value); }}
											>
												{truncate(value, 8)}
											</button>
										{/if}
									{:else if col.dimension === 'money'}
										{formatMoney(value)}
									{:else if col.dimension === 'quantity'}
										{formatNumber(value)}
									{:else if col.dimension === 'time-point'}
										{formatDateTime(value)}
									{:else if col.truncateTooltip}
										<Tooltip.Root>
											<Tooltip.Trigger class="block max-w-[14rem] truncate text-left">
												{String(value)}
											</Tooltip.Trigger>
											<Tooltip.Content>{String(value)}</Tooltip.Content>
										</Tooltip.Root>
									{:else}
										{formatValue(value)}
									{/if}
								{% endraw %}{% raw %}</span>
								{/each}
							</div>
						{/if}
{% endraw %}
{% if has_workflow and ux.workflow_status_field %}
{% raw %}						<Badge variant={workflowVariant(String((row as Record<string, unknown>)['{% endraw %}{{ ux.workflow_status_field }}{% raw %}'] ?? ''))} data-testid="{% endraw %}{{ tid.timeline_workflow_state }}{% raw %}">
							{String((row as Record<string, unknown>)['{% endraw %}{{ ux.workflow_status_field }}{% raw %}'] ?? '')}
						</Badge>
{% endraw %}
{% endif %}
{% raw %}					</div>
{% endraw %}
{% if ux_actions %}
{% raw %}					<div class="timeline-actions">{% endraw %}{% raw %}
									{#each ux_actions.primary as item}
										<Button
											variant="ghost"
											size="sm"
											onclick={(e) => { e.stopPropagation(); handleRowClick(row as Record<string, unknown>); }}
										>
											{actionLabel(item.action, item.label)}
										</Button>
									{/each}
{% endraw %}
{% if ux_actions.menu %}
{% raw %}
									<DropdownMenu.Root>
										<DropdownMenu.Trigger>
											{#snippet child({ props })}
											<Button
												{...props}
												variant="ghost"
												size="sm"
												data-testid="{% endraw %}{{ tid.actions }}{% raw %}"
												onclick={(e) => { e.stopPropagation(); props.onclick?.(e); }}
											>
												{m.common_actions()}
											</Button>
											{/snippet}
										</DropdownMenu.Trigger>
										<DropdownMenu.Portal>
											<DropdownMenu.Content data-testid="{% endraw %}{{ tid.actions_menu }}{% raw %}" class="w-40">
												{#each ux_actions.menu as item}
													{#if item.action === 'delete'}
													<DropdownMenu.Item
														class="text-destructive data-[highlighted]:text-destructive"
														data-testid="{% endraw %}{{ tid.action_delete }}{% raw %}"
														onclick={(e) => { e.stopPropagation(); requestDelete(row as Record<string, unknown>); }}
													>
														{actionLabel(item.action, item.label)}
													</DropdownMenu.Item>
													{:else if item.action === 'edit'}
													<DropdownMenu.Item
														data-testid="{% endraw %}{{ tid.action_edit }}{% raw %}"
														onclick={(e) => { e.stopPropagation(); goto(`${basePath}/${row['id']}/edit`); }}
													>
														{actionLabel(item.action, item.label)}
													</DropdownMenu.Item>
													{:else}
													<DropdownMenu.Item
														data-testid="{% endraw %}{{ module_name }}{% raw %}-action-{item.action}"
														onclick={(e) => { e.stopPropagation(); handleRowClick(row as Record<string, unknown>); }}
													>
														{actionLabel(item.action, item.label)}
													</DropdownMenu.Item>
													{/if}
												{/each}
											</DropdownMenu.Content>
										</DropdownMenu.Portal>
									</DropdownMenu.Root>
{% endraw %}
{% endif %}
{% raw %}
								{% endraw %}{% raw %}</div>
{% endraw %}
{% endif %}
{% raw %}				</li>
			{/each}
		</ol>
{% endraw %}
