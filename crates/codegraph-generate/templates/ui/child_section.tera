<!-- Child section accordion for {{ section.label }} ({{ section.entity_name }}) -->
<!-- Included from detail_page.tera inside the child_sections loop -->
{% raw %}
<div class="border rounded-lg overflow-hidden">
	<!-- Collapsible header -->
	<button
		class="flex w-full items-center justify-between px-4 py-3 text-sm font-medium bg-muted/50 hover:bg-muted transition-colors"
		onclick={() => toggleSection('{% endraw %}{{ section.module_name }}{% raw %}')}
		data-testid="{% endraw %}{{ section.tid.child_section }}{% raw %}"
		type="button"
	>
		<span class="flex items-center gap-2">
			<span>{% endraw %}{{ section.label }}{% raw %}</span>
			<span class="text-xs text-muted-foreground font-normal">
				({{% endraw %}{{ section.module_name }}{% raw %}Items.length})
			</span>
		</span>
		<span class="text-muted-foreground">
			{expandedSections.has('{% endraw %}{{ section.module_name }}{% raw %}') ? '▼' : '▶'}
		</span>
	</button>

	<!-- Expanded content -->
	{#if expandedSections.has('{% endraw %}{{ section.module_name }}{% raw %}')}
		<div class="p-4 space-y-3">
			<!-- Add button -->
			<div class="flex justify-end">
				<button
					class="inline-flex items-center gap-1 rounded-md border px-3 py-1.5 text-xs font-medium hover:bg-accent transition-colors"
					onclick={() => startAddChild('{% endraw %}{{ section.domain }}{% raw %}', '{% endraw %}{{ section.path_segment }}{% raw %}')}
					data-testid="{% endraw %}{{ section.tid.child_section_add_btn }}{% raw %}"
					type="button"
				>
					+ Add
				</button>
			</div>

			<!-- Items list -->
			{#if {% endraw %}{{ section.module_name }}{% raw %}Items.length === 0}
				<p class="text-sm text-muted-foreground text-center py-4">No items yet.</p>
			{:else}
				<ul class="divide-y divide-border rounded-md border">
					{#each {% endraw %}{{ section.module_name }}{% raw %}Items as child (child.id)}
						<li class="flex items-center justify-between px-3 py-2 text-sm">
							<span class="truncate text-foreground">
								{child.id}
							</span>
							<div class="flex shrink-0 items-center gap-1 ml-2">{% endraw %}{% if ux_actions.child_menu %}{% raw %}
								<!-- ux-rules (#299): primary open/manage stays inline (the
								     Manage → link below); Edit/Delete tier into the
								     per-item actions menu, Delete behind the plan's
								     confirmation. -->
								<DropdownMenu.Root>
									<DropdownMenu.Trigger
										class="rounded px-2 py-1 text-xs hover:bg-accent transition-colors"
										data-testid="{% endraw %}{{ section.tid.actions }}{% raw %}"
									>
										{m.common_actions()}
									</DropdownMenu.Trigger>
									<DropdownMenu.Portal>
										<DropdownMenu.Content data-testid="{% endraw %}{{ section.tid.actions_menu }}{% raw %}" class="w-40">
											{#each ux_actions.child_menu as item}
												{#if item.action === 'edit'}
												<DropdownMenu.Item
													data-testid="{% endraw %}{{ section.tid.action_edit }}{% raw %}"
													onclick={() => editChild('{% endraw %}{{ section.domain }}{% raw %}', '{% endraw %}{{ section.path_segment }}{% raw %}', child.id)}
												>
													{m.common_edit()}
												</DropdownMenu.Item>
												{:else if item.action === 'delete'}
												<DropdownMenu.Item
													class="text-destructive data-[highlighted]:text-destructive"
													data-testid="{% endraw %}{{ section.tid.action_delete }}{% raw %}"
 													onclick={() => {% endraw %}{% if ux_actions.confirm_delete %}{% raw %}{% endraw %}{{ section.module_name }}{% raw %}DeleteId = child.id}{% endraw %}{% else %}{% raw %} void deleteChild('{% endraw %}{{ section.domain }}{% raw %}', '{% endraw %}{{ section.path_segment }}{% raw %}', child.id)}{% endraw %}{% endif %}{% raw %}
												>
													{m.common_delete()}
												</DropdownMenu.Item>
												{/if}
											{/each}
										</DropdownMenu.Content>
									</DropdownMenu.Portal>
								</DropdownMenu.Root>
								{% endraw %}{% else %}{% raw %}
								<button
									class="rounded px-2 py-1 text-xs hover:bg-accent transition-colors"
									onclick={() => editChild('{% endraw %}{{ section.domain }}{% raw %}', '{% endraw %}{{ section.path_segment }}{% raw %}', child.id)}
									type="button"
								>
									Edit
								</button>
								<button
									class="rounded px-2 py-1 text-xs text-destructive hover:bg-destructive/10 transition-colors"
									onclick={() => deleteChild('{% endraw %}{{ section.domain }}{% raw %}', '{% endraw %}{{ section.path_segment }}{% raw %}', child.id)}
									type="button"
								>
									Delete
								</button>
								{% endraw %}{% endif %}{% if section.has_children %}{% raw %}
								<button
									class="rounded px-2 py-1 text-xs hover:bg-accent transition-colors"
									onclick={() => manageChild('{% endraw %}{{ section.domain }}{% raw %}', '{% endraw %}{{ section.path_segment }}{% raw %}', child.id)}
									data-testid="{% endraw %}{{ section.tid.manage_btn }}{% raw %}"
									type="button"
								>
									Manage →
								</button>
								{% endraw %}{% endif %}{% raw %}
							</div>
						</li>
					{/each}
				</ul>
			{/if}
		</div>
	{/if}{% endraw %}{% if ux_actions %}{% if ux_actions.confirm_delete %}
	<AlertDialog.Root open={{"{"}}{{ section.module_name }}DeleteId !== null} onOpenChange={(v) => { if (!v) {{ section.module_name }}DeleteId = null; }}>{% raw %}
		<AlertDialog.Content data-testid="{% endraw %}{{ section.tid.delete_dialog }}{% raw %}">
			<AlertDialog.Header>
				<AlertDialog.Title>{m.common_confirm_delete_title({ entity: '{% endraw %}{{ section.entity_name }}{% raw %}' })}</AlertDialog.Title>
				<AlertDialog.Description>
					{m.common_confirm_delete_description()}
				</AlertDialog.Description>
			</AlertDialog.Header>
			<AlertDialog.Footer>
				<AlertDialog.Cancel>{m.common_cancel()}</AlertDialog.Cancel>
				<AlertDialog.Action
					onclick={confirmDelete{% endraw %}{{ section.entity_name }}{% raw %}Child}
					data-testid="{% endraw %}{{ section.tid.delete_dialog_confirm }}{% raw %}"
					class="bg-destructive text-destructive-foreground hover:bg-destructive/90"
				>
					{m.common_delete()}
				</AlertDialog.Action>
			</AlertDialog.Footer>
		</AlertDialog.Content>
	</AlertDialog.Root>
	{% endraw %}{% endif %}{% endif %}{% raw %}
</div>
{% endraw %}
