    return this.table.tooltipFor(text);
  }

{% endif %}
{% if pom.ux.actions %}
  async openActions(row?: Locator): Promise<Locator> {
    return this.table.openActions(row);
  }

  menu(): Locator {
    return this.table.menu();
  }

