    return this.table.firstCell();
  }

  async headerCount(): Promise<number> {
    return this.table.headerCount();
  }

{% endif %}
{% if pom.ux.chip_checks | length > 0 %}
  chipFor(text: string): Locator {
    return this.table.chipFor(text);
  }

{% endif %}
{% if pom.ux.align_checks | length > 0 or pom.ux.format_checks | length > 0 %}
  async expectRightAligned(tdIndex: number, sortKey?: string): Promise<void> {
    await this.table.expectRightAligned(tdIndex, sortKey);
  }

  async expectFormatted(
    tdIndex: number,
    kind: 'money' | 'quantity' | 'time-point',
    value: number | string,
  ): Promise<void> {
    await this.table.expectFormatted(tdIndex, kind, value);
  }

{% endif %}
{% if pom.ux.copy_check %}
  copyTrigger(row: Locator): Locator {
