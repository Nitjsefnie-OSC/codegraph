{#
  Per-entity Playwright Object Model page class (issue #316).
  Rendered for every spec-emitting (any-op) entity into
  `ui/tests/generated/{domain}/{seg}.page.ts`. Selector knowledge comes
  from `UiE2eTestContext.pom` (urls / per-field input kinds / workflow /
  ux plan mirror) — the 11 spec families construct ZERO raw locators.
  Plan-driven surface: the ux forwarders are emitted only when the
  entity's plan supports the feature (form follows data, applied to the
  test API).
#}
// Generated by {{ project.generator_name }}. DO NOT EDIT.
//
// Playwright Object Model page class for {{ entity_name }} (issue #316).
// All selector/testid construction lives here; specs assert against the
// locators and flows this class returns.

import {
  expect,
  type Locator,
  type Page,
  type Response,
} from '@playwright/test';

import { BasePage{% if pom.ux %}, UxTable{% endif %} } from '../_support/pom';
{%- if project.testid_module %}
// One testid vocabulary (issue #468 W3): locators resolve through the
// generated module — renaming an entry there fails `tsc`/`svelte-check`
// here, instead of failing Playwright at runtime.
import { shared, testids, tidFor } from '#lib/testids.js';
{% endif %}

export class {{ entity_name }}Page extends BasePage {
  /** Testid prefix family (the entity's snake_case module name). */
  readonly module = '{{ module_name }}';

  /** API collection path (fixture setup stays API-driven in the specs). */
  static readonly apiPath = '/{{ domain }}/{{ path_segment }}';

  /** The create-form submit redirect target (edit asserts the same). */
  static readonly detailUrlPattern = new RegExp(
    {%- if parent and parent.grandparent %}
    `/{{ parent.grandparent.domain }}/{{ parent.grandparent.path_segment }}/[0-9a-f-]+/{{ parent.path_segment }}/[0-9a-f-]+/{{ path_segment }}/[0-9a-f-]+$`,
    {%- elif parent %}
    `/{{ parent.domain }}/{{ parent.path_segment }}/[0-9a-f-]+/{{ path_segment }}/[0-9a-f-]+$`,
    {%- else %}
    `/{{ domain }}/{{ path_segment }}/[0-9a-f-]+$`,
    {%- endif %}
  );

  private readonly base: string;

{% if parent %}
  // Nested child route: the parent chain is created at runtime (beforeAll
  // API fixtures), so the spec passes the resolved base path.
  constructor(page: Page, base: string) {
    super(page);
    this.base = base;
  }
{% else %}
  constructor(page: Page, base = '{{ pom.urls.list }}') {
    super(page);
    this.base = base;
  }
{% endif %}

  // ── Routes (pom.urls) ───────────────────────────────────────────────

  listUrl(): string {
    return this.base;
  }

  createUrl(): string {
    return `${this.base}/new`;
  }

  detailUrl(id: string): string {
    return `${this.base}/${id}`;
  }

  editUrl(id: string): string {
    return `${this.base}/${id}/edit`;
  }

  /** Raw navigation — returns the response, mirroring `page.goto`. */
  async gotoList(): Promise<Response | null> {
    return this.page.goto(this.listUrl());
  }

  /** List route + the hydration wait the generated specs share. */
  async openList(): Promise<void> {
    await this.gotoList();
    await this.waitForListReady();
  }

  /** List route with a query string (`?sort=` / `?q=`) + hydration. */
  async openListAt(query: string): Promise<void> {
    await this.page.goto(`${this.listUrl()}${query}`);
    await this.waitForListReady();
  }

  /**
   * Hydration + any terminal list state. An empty result set (search with no
   * matches, org with no rows) renders the empty/no-results markers instead
   * of the table — and never the pagination — so wait for whichever shows.
   */
  async waitForListReady(): Promise<void> {
    await this.page.waitForSelector('body.hydrated');
    const table = this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.table}"]`{% else %}`[data-testid="${this.module}-table"]`{% endif %});
    const empty = this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.empty}"]`{% else %}`[data-testid="${this.module}-empty"]`{% endif %});
    const noResults = this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.noResults}"]`{% else %}`[data-testid="${this.module}-no-results"]`{% endif %});
    await table.or(empty).or(noResults).waitFor({ state: 'visible' });
  }

  async gotoCreate(): Promise<Response | null> {
    return this.page.goto(this.createUrl());
  }

  async gotoDetail(id: string): Promise<Response | null> {
    return this.page.goto(this.detailUrl(id));
  }

  async gotoEdit(id: string): Promise<Response | null> {
    return this.page.goto(this.editUrl(id));
  }

  // ── List-page surface ───────────────────────────────────────────────

  tableRoot(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.table}"]`{% else %}`[data-testid="${this.module}-table"]`{% endif %});
  }

  emptyState(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.empty}"]`{% else %}`[data-testid="${this.module}-empty"]`{% endif %});
  }

  noResults(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.noResults}"]`{% else %}`[data-testid="${this.module}-no-results"]`{% endif %});
  }

  pagination(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.pagination}"]`{% else %}`[data-testid="${this.module}-pagination"]`{% endif %});
  }

  createButton(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.createBtn}"]`{% else %}`[data-testid="${this.module}-create-btn"]`{% endif %});
  }

  searchInput(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.search}"] input`{% else %}`[data-testid="${this.module}-search"] input`{% endif %});
  }

  /** A detail-page child section (`child-section-{module}`). */
  childSection(module: string): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${tidFor(module).childSection}"]`{% else %}`[data-testid="child-section-${module}"]`{% endif %});
  }

  // ── Form surface ────────────────────────────────────────────────────

  formRoot(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.form}"]`{% else %}`[data-testid="${this.module}-form"]`{% endif %});
  }

  submitButton(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.submitBtn}"]`{% else %}`[data-testid="${this.module}-submit-btn"]`{% endif %});
  }

  cancelButton(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.cancelBtn}"]`{% else %}`[data-testid="${this.module}-cancel-btn"]`{% endif %});
  }

  /** A create/edit form input by field name (the `#name` convention). */
  formInput(name: string): Locator {
    return this.page.locator(`#${name}`);
  }

  async waitForForm(): Promise<void> {
    await this.waitForHydration({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.submitBtn}"]`{% else %}`[data-testid="${this.module}-submit-btn"]`{% endif %});
  }

  async submit(): Promise<void> {
    await this.submitButton().click();
  }

  async cancel(): Promise<void> {
    await this.cancelButton().click();
  }

  // ── Form fills (pom.fields — one method per input kind) ─────────────

{% for field in pom.fields %}
{% if field.input_kind == "text" %}
  async fill{{ field.name | pascal_case }}(value: string): Promise<void> {
    const el = this.formInput('{{ field.name }}');
    if (await el.isVisible()) {
      await el.clear();
      await el.fill(value);
    }
  }
{% elif field.input_kind == "select" %}
  async fill{{ field.name | pascal_case }}(value: string): Promise<void> {
    const el = this.formInput('{{ field.name }}');
    if (await el.isVisible()) {
      await el.selectOption(value);
    }
  }
{% elif field.input_kind == "checkbox" %}
  async fill{{ field.name | pascal_case }}(value: boolean): Promise<void> {
    const el = this.formInput('{{ field.name }}');
    if (await el.isVisible()) {
      const isChecked = (await el.getAttribute('aria-checked')) === 'true';
      if (value !== isChecked) {
        await el.click();
      }
    }
  }
{% elif field.input_kind == "datetime-local" %}
  /** Datetime inputs take the local (Z-stripped) form. */
  async fill{{ field.name | pascal_case }}(value: string): Promise<void> {
    const el = this.formInput('{{ field.name }}');
    if (await el.isVisible()) {
      await el.clear();
      await el.fill(value.replace(/:\d{2}Z$/, ''));
    }
  }
{% elif field.input_kind == "entity-ref" %}
  /** Entity refs are filled from the created dependency id. */
  async fill{{ field.name | pascal_case }}(value: string): Promise<void> {
    if (!value) {
      return;
    }
    const el = this.formInput('{{ field.name }}');
    if (await el.isVisible()) {
      await el.clear();
      await el.fill(value);
    }
  }
{% elif field.input_kind == "date-range" %}
  /** DateRangeField: set the sr-only input + Svelte input event. */
  async fill{{ field.name | pascal_case }}(value: string): Promise<void> {
    await this.page
      .locator(`[data-testid="{{ field.name }}-value"]`)
      .evaluate(
        (el: HTMLInputElement, val: string) => {
          el.value = val;
          el.dispatchEvent(new Event('input', { bubbles: true }));
        },
        value,
      );
  }
{% elif field.input_kind == "structured" %}
  /** StructuredWrapper: first sub-field input (`{field}-{sub}`). */
  async fill{{ field.name | pascal_case }}(value: string): Promise<void> {
    const el = this.page.locator(`[data-testid="{{ field.name }}-{{ field.sub_field | default(value="") }}"]`);
    if (await el.isVisible()) {
      await el.clear();
      await el.fill(value);
    }
  }
{% elif field.input_kind == "structured-array" %}
  /** StructuredWrapper array rows (`{field}-{i}-{sub}` + add button). */
  async fill{{ field.name | pascal_case }}(values: string[]): Promise<void> {
    const first = this.page.locator(`[data-testid="{{ field.name }}-0-{{ field.sub_field | default(value="") }}"]`);
    if (!(await first.isVisible())) {
      return;
    }
    for (let i = 0; i < values.length; i++) {
      if (i > 0) {
        await this.page.locator(`[data-testid="{{ field.name }}-add-btn"]`).click();
      }
      await this.page.locator(`[data-testid="{{ field.name }}-${i}-{{ field.sub_field | default(value="") }}"]`).fill(values[i]);
    }
  }
{% elif field.input_kind == "array" %}
  /** Plain string-array rows (`{field}-row-{i}` + add/remove buttons). */
  async fill{{ field.name | pascal_case }}(values: string[]): Promise<void> {
    const existingRows = await this.page.locator(`[data-testid^="{{ field.name }}-row-"]`).count();
    for (let i = existingRows - 1; i > 0; i--) {
      await this.page.locator(`[data-testid="{{ field.name }}-remove-${i}"]`).click();
    }
    for (let i = 0; i < values.length; i++) {
      if (i > 0) {
        await this.page.locator(`[data-testid="{{ field.name }}-add-btn"]`).click();
      }
      await this.page.locator(`[data-testid="{{ field.name }}-row-${i}"] input`).fill(values[i]);
    }
  }
{% elif field.input_kind == "geometry" %}
  // '{{ field.name }}' geometry — omitted from form fill (the API rejects
  // plain WKT without ST_GeomFromText).
{% elif field.input_kind == "value-object" %}
  // '{{ field.name }}' ValueObject — the form renders its own structured
  // sub-fields; the create body omits it (serde default).
{% endif %}
{% endfor %}

  // ── Detail surface ──────────────────────────────────────────────────

  /** `{module}-field-{name}` — a detail-page field value slot. */
  field(name: string): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.field(name)}"]`{% else %}`[data-testid="${this.module}-field-${name}"]`{% endif %});
  }

  detailHeading(): Locator {
    return this.page.getByRole('heading', { name: '{{ entity_label }}' });
  }

  editButton(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.editBtn}"]`{% else %}`[data-testid="${this.module}-edit-btn"]`{% endif %});
  }

  deleteButton(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.deleteBtn}"]`{% else %}`[data-testid="${this.module}-delete-btn"]`{% endif %});
  }

  /** Enter the edit form from the detail page. */
  async edit(): Promise<void> {
    await this.editButton().click();
  }

  /** Detail-page delete: open the dialog, confirm. */
  async delete(): Promise<void> {
    await this.waitForHydration({% if project.testid_module %}`[data-testid="${testids.{{ module_name }}.deleteBtn}"]`{% else %}`[data-testid="${this.module}-delete-btn"]`{% endif %});
    await this.deleteButton().click();
    await expect(this.page.locator({% if project.testid_module %}`[data-testid="${shared.confirmDialog}"]`{% else %}'[data-testid="confirm-dialog"]'{% endif %})).toBeVisible({ timeout: 20_000 });
    await this.page.locator({% if project.testid_module %}`[data-testid="${shared.confirmDialogConfirm}"]`{% else %}'[data-testid="confirm-dialog-confirm"]'{% endif %}).click();
  }

{% if pom.workflow %}
  // ── Workflow (pom.workflow: states={{ pom.workflow.states | join(sep=",") }}) ──

  workflowPanel(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${shared.workflowPanel}"]`{% else %}'[data-testid="workflow-panel"]'{% endif %});
  }

  workflowState(): Locator {
    return this.page.locator({% if project.testid_module %}`[data-testid="${shared.workflowState}"]`{% else %}'[data-testid="workflow-state"]'{% endif %});
  }

  async waitForWorkflow(): Promise<void> {
    await this.waitForHydration({% if project.testid_module %}`[data-testid="${shared.workflowPanel}"]`{% else %}'[data-testid="workflow-panel"]'{% endif %});
  }

  async expectState(state: string): Promise<void> {
    await expect(this.workflowState()).toContainText(state);
  }

  /** Every available transition button (state-machine driven). */
  transitionButtons(): Locator {
    return this.workflowPanel().locator('button');
  }

  /** Click the "Transition to {state}" button by exact label. */
  async transitionTo(state: string): Promise<void> {
    await this.workflowPanel()
      .getByRole('button', { name: `Transition to ${state}`, exact: true })
      .click();
  }

{% endif %}
{% if pom.ux %}
  // ── ux-rules plan surface (pom.ux — plan-driven forwarders) ─────────

  readonly table = new UxTable(this.page, {
    module: this.module,
    locale: '{{ pom.ux.locale }}',
{% if pom.ux.currency %}
    currency: '{{ pom.ux.currency }}',
{% endif %}
  });

{% if pom.ux.has_table %}
