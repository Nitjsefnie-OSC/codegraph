{#
  Shared entity-ref dependency setup. Rendered via `{% include %}` with
  `dep_section` set by the caller to one of: "before_all", "after_all",
  "test_data". The include shares the caller's context, so it can read
  `dependency_steps`, `dependency_errors`, and `entity_ref_deps` directly.
#}
{%- if dep_section == "before_all" -%}
{% if dependency_errors | length > 0 %}
    {# keep the message quote-free (see deps.rs) — model titles interpolate
       into this single-quoted JS string. #}
    throw new Error('{{ dependency_errors | join(sep="; ") }}');
{% endif %}
{% for step in dependency_steps %}
{%- if step.optional %}
    // Dependency has no create route (e.g. seeded reference data) — tolerate
    // the failure and leave the FK unset when the row does not pre-exist.
    try {
      const dep_{{ loop.index }} = await createEntityAsAcme(orgContext, '{{ step.api_path }}', { {{ step.fields_json }}{% for fk in step.fk_map %}, '{{ fk[0] }}': depIds['{{ fk[1] }}']{% endfor %} });
      depIds['{{ step.dep_id }}'] = {% if step.is_array %}[dep_{{ loop.index }}['id'] as string]{% else %}dep_{{ loop.index }}['id'] as string{% endif %};
    } catch (e) {
      console.warn(`optional dependency {{ step.dep_id }} unavailable: ${e}`);
    }
{% else %}
{%- if step.cycle_breaks | length > 0 %}
{%- for brk in step.cycle_breaks %}
    // fixture: breaking required-FK cycle {{ brk.cycle_path }} by omitting '{{ brk.fk }}' on {{ brk.on_entity }}
{%- endfor %}
    try {
      const dep_{{ loop.index }} = await createEntityAsAcme(orgContext, '{{ step.api_path }}', { {{ step.fields_json }}{% for fk in step.fk_map %}, '{{ fk[0] }}': depIds['{{ fk[1] }}']{% endfor %} });
      depIds['{{ step.dep_id }}'] = {% if step.is_array %}[dep_{{ loop.index }}['id'] as string]{% else %}dep_{{ loop.index }}['id'] as string{% endif %};
    } catch (e) {
      throw new Error(`fixture: cycle-break create for '{{ step.dep_id }}' failed — the FK omitted to break the cycle ({{ step.cycle_break_paths }}) is still required by the API; make one ref optional in the model. Original error: ${e}`);
    }
{% else %}
    const dep_{{ loop.index }} = await createEntityAsAcme(orgContext, '{{ step.api_path }}', { {{ step.fields_json }}{% for fk in step.fk_map %}, '{{ fk[0] }}': depIds['{{ fk[1] }}']{% endfor %} });
    depIds['{{ step.dep_id }}'] = {% if step.is_array %}[dep_{{ loop.index }}['id'] as string]{% else %}dep_{{ loop.index }}['id'] as string{% endif %};
{% endif -%}
{% endif -%}
{% endfor %}
{%- elif dep_section == "after_all" -%}
    const baseUrl = process.env.PUBLIC_API_URL ?? 'http://localhost:3000';
{% for step in dependency_steps | reverse %}
    {
      const ids = depIds['{{ step.dep_id }}'];
      if (ids) {
        for (const id of (Array.isArray(ids) ? ids : [ids])) {
          try {
            await fetch(`${baseUrl}/api/v1{{ step.api_path }}/${id}`, {
              method: 'DELETE',
              headers: { 'Authorization': `Bearer ${orgContext.acme.apiKey}` },
            });
          } catch { /* best effort */ }
        }
      }
    }
{% endfor %}
{%- elif dep_section == "test_data" -%}
{% for dep in entity_ref_deps %}
    ...(depIds['{{ dep.dep_id }}'] ? { '{{ dep.field_name }}': depIds['{{ dep.dep_id }}'] } : {}),
{% endfor %}
{%- endif -%}
