/// Query parameters for the tree endpoint.
#[derive(Debug, serde::Deserialize, utoipa::IntoParams)]
#[into_params(parameter_in = Query)]
pub struct TreeParams {
    /// Maximum tree depth to return. Omit for unlimited.
    pub depth: Option<i32>,
}

/// Get the subtree rooted at the given {{ entity_name }}.
#[utoipa::path(
    get,
{% if role == "child" %}
    path = "/api/{{ project.api_version }}/{{ parent_domain | default(value=domain) }}/{{ parent_path_segment }}/{ {{- parent_param_name -}} }/{{ path_segment }}/{ {{- param_name -}} }/tree",
{% else %}
    path = "/api/{{ project.api_version }}/{{ domain }}/{{ path_segment }}/{ {{- param_name -}} }/tree",
{% endif %}
    tag = "{{ tag }}",
    operation_id = "{{ domain }}_{{ module_name }}_tree",
    params(
        ("{{ param_name }}" = Uuid, Path, description = "Root {{ entity_name }} ID"),
        TreeParams,
    ),
    responses(
        (status = 200, description = "Subtree as flat list ordered by depth"),
        (status = 404, description = "Root not found"),
    )
)]
#[tracing::instrument(skip(state, headers), fields(domain = "{{ domain }}", entity = "{{ module_name }}"))]
pub async fn tree(
    State(state): State<AppState>,
    Extension(api_key_info): Extension<ApiKeyInfo>,
    headers: HeaderMap,
{% if role == "child" %}
{% if ancestor_path_params >= 2 %}
    Path((_grandparent_id, _parent_id, id)): Path<(Uuid, Uuid, Uuid)>,
{% else %}
    Path((_parent_id, id)): Path<(Uuid, Uuid)>,
{% endif %}
{% else %}
    Path(id): Path<Uuid>,
{% endif %}
    axum::extract::Query(params): axum::extract::Query<TreeParams>,
) -> Result<Json<Vec<{% if tree_include %}serde_json::Value{% else %}{{ entity_name }}Response{% endif %}>>, AppError> {
    let correlation_id = extract_correlation_id(&headers);
    tracing::info!(%correlation_id, %id, "fetching subtree");

{% if project.persistence_provider == "sea_orm" %}
    use sea_orm::{ConnectionTrait, TransactionTrait};
    use crate::domain::{{ domain }}::{{ module_name }}::repository::{{ entity_name }}Repository;
    let db = state.db.begin().await
        .map_err(|e| AppError::internal(format!("Failed to begin transaction: {e}")))?;

    // Set RLS session vars so Postgres policies can enforce tenant isolation.
    // One round trip (#169): set_config + SET LOCAL ROLE bundled into a single
    // simple-query payload; values are server-side UUIDs (AuthInfo).
    db.execute_unprepared(&format!(
        "SELECT set_config('app.current_api_key', '{}', true), \
                set_config('app.current_api_key_id', '{}', true), \
                set_config('app.organization_id', '{}', true); \
         SET LOCAL ROLE app_user",
        api_key_info.api_key_id,
        api_key_info.api_key_id,
        api_key_info.organization_id,
    )).await
        .map_err(|e| AppError::internal(format!("Failed to set RLS context: {e}")))?;

    let repo = crate::domain::{{ domain }}::{{ module_name }}::repository_impl::{{ entity_name }}RepositoryImpl;
    let rows = repo.find_tree(&db, id, params.depth).await
        .map_err(|e| {
            let msg = e.to_string();
            let base = if msg.contains("INSUFFICIENT_SCOPE")
                || msg.contains("ROLE_FORBIDDEN")
                || msg.contains("violates row-level security policy")
            {
                AppError::forbidden(msg)
            } else {
                AppError::internal(msg)
            };
            base.with_correlation_id(correlation_id)
        })?;
    db.commit().await
        .map_err(|e| AppError::internal(format!("Failed to commit transaction: {e}")))?;

    if rows.is_empty() {
        return Err(AppError::not_found(format!("{{ entity_name }} {} not found", id)));
    }

    Ok(Json(rows))
{% else %}
    // Cornucopia provider: the query handler owns the client, transaction
    // and RLS session vars; the recursive CTE is a compiled query in the
    // SQL-first repository.
    let rows = state.{{ domain }}_{{ module_name }}_queries.find_tree(id, params.depth, api_key_info.api_key_id, api_key_info.organization_id, api_key_info.user_id, api_key_info.role.clone()).await
        .map_err(|e| AppError::internal(format!("Failed to fetch subtree: {e}")).with_correlation_id(correlation_id))?;

    if rows.is_empty() {
        return Err(AppError::not_found(format!("{{ entity_name }} {} not found", id)).with_correlation_id(correlation_id));
    }

    Ok(Json(rows))
{% endif %}
}
{% endif %}
{% if has_create or has_read or has_update or has_delete or has_list %}
