            crate::doctor::run_checks().await;
        }
        Commands::Migrate { database_url, config } => {
            if let Some(c) = config {
                std::env::set_var("APP_CONFIG", &c);
            }
            if std::env::var("DATABASE_URL").is_err() {
                if let Ok(cfg) = crate::config::ServerConfig::load(None) {
                    if let Some(url) = cfg.database_url {
                        std::env::set_var("DATABASE_URL", url);
                    }
                }
            }
            if let Some(u) = database_url {
                std::env::set_var("DATABASE_URL", &u);
            }
            if let Err(e) = crate::migration::run_migrations().await {
                eprintln!("Migration error: {e}");
                std::process::exit(1);
            }
        }
        Commands::Stop { bind_addr, pid_file, force, timeout } => {
            #[cfg(not(unix))]
