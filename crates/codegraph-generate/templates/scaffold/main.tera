    },
    /// Run pre-flight diagnostic checks
    Doctor {
        #[arg(long = "database-url", env = "DATABASE_URL")]
        database_url: Option<String>,
        #[arg(long = "config", env = "APP_CONFIG")]
        config: Option<String>,
    },
    /// Print version information
    Version,
}

#[cfg(unix)]
fn send_signal(pid: u32, sig: i32) -> bool {
    unsafe { libc::kill(pid as i32, sig) == 0 }
}

#[cfg(unix)]
fn process_exists(pid: u32) -> bool {
    unsafe { libc::kill(pid as i32, 0) == 0 }
}

/// Extract the TCP port from a bind address like "0.0.0.0:3000" or "127.0.0.1:3099".
fn port_from_bind_addr(bind_addr: &str) -> Option<u16> {
    bind_addr
        .rsplit(':')
        .next()
        .and_then(|p| p.parse::<u16>().ok())
}

/// Discover the PID of the process listening on `port` by scanning /proc.
/// Used as a fallback for `stop`/`status` when the PID file is missing or stale.
#[cfg(target_os = "linux")]
fn find_pid_by_port(port: u16) -> Option<u32> {
    let port_hex = format!("{:04X}", port);
    // 1. Collect socket inodes for the port from /proc/net/tcp and tcp6.
    let mut inodes: Vec<String> = Vec::new();
    for path in ["/proc/net/tcp", "/proc/net/tcp6"] {
        if let Ok(content) = std::fs::read_to_string(path) {
            for line in content.lines().skip(1) {
                let fields: Vec<&str> = line.split_whitespace().collect();
                if fields.len() >= 10 {
                    if let Some(addr) = fields[1].split(':').nth(1) {
                        if addr == port_hex {
                            inodes.push(fields[9].to_string());
                        }
                    }
                }
            }
        }
    }
    if inodes.is_empty() {
        return None;
    }
    // 2. Scan every process's open fds for a socket matching one of the inodes.
    if let Ok(entries) = std::fs::read_dir("/proc") {
        for entry in entries.flatten() {
            let pid = match entry.file_name().to_string_lossy().parse::<u32>() {
                Ok(p) => p,
                Err(_) => continue,
            };
            let fd_dir = format!("/proc/{pid}/fd");
            if let Ok(fds) = std::fs::read_dir(&fd_dir) {
                for fd in fds.flatten() {
                    let target = match std::fs::read_link(fd.path()) {
                        Ok(t) => t.to_string_lossy().to_string(),
                        Err(_) => continue,
                    };
                    if let Some(inode) = target
                        .strip_prefix("socket:[")
                        .and_then(|s| s.strip_suffix(']'))
                    {
                        if inodes.iter().any(|i| i == inode) {
                            return Some(pid);
                        }
                    }
                }
            }
        }
    }
    None
}

#[cfg(not(target_os = "linux"))]
fn find_pid_by_port(_port: u16) -> Option<u32> {
    None
}

#[tokio::main]
async fn main() {
    let cli = Cli::parse();
    match cli.command {
        Commands::Start { bind_addr, database_url, config, pid_file } => {
            if let Some(a) = bind_addr.as_deref() {
                std::env::set_var("BIND_ADDR", a);
            }
            if let Some(u) = database_url {
                std::env::set_var("DATABASE_URL", &u);
            }
            if let Some(c) = config {
                std::env::set_var("APP_CONFIG", &c);
            }
            let pf_path = pid_file_path(bind_addr.as_deref(), pid_file.as_deref());
            let pid = std::process::id();
            if let Err(e) = std::fs::write(&pf_path, pid.to_string()) {
                eprintln!("warning: could not write PID file {pf_path}: {e}");
            } else {
                tracing::info!("PID {pid} written to {pf_path}");
            }
            let result = crate::server::run_server().await;
            let _ = std::fs::remove_file(&pf_path);
            if let Err(e) = result {
                eprintln!("fatal: {e}");
                std::process::exit(1);
            }
        }
        Commands::Version => {
            use shadow_rs::shadow;
            shadow!(build);
            println!("{} {}", env!("CARGO_PKG_NAME"), build::PKG_VERSION);
            println!("Git commit:  {}", build::SHORT_COMMIT);
            println!("Git branch:  {}", build::BRANCH);
            println!("Build time:  {}", build::BUILD_TIME_3339);
            println!("Rust:        {} ({})", build::RUST_VERSION, build::RUST_CHANNEL);
            println!("OS:          {}", build::BUILD_OS);
        }
        Commands::Init { output } => {
            let config = crate::config::ServerConfig::default();
            match toml::to_string_pretty(&config) {
                Ok(toml) => {
                    if let Err(e) = std::fs::write(&output, toml) {
                        eprintln!("Failed to write {output}: {e}");
                        std::process::exit(1);
                    }
                    println!("Configuration written to {output}");
