                let pid_str = match std::fs::read_to_string(&pf_path) {
                    Ok(s) => s.trim().to_string(),
                    Err(_) => {
                        // PID file missing — try to discover the listener on the
                        // configured port so a stale/cleaned PID file can still
                        // be stopped (frees the port).
                        let discovered = bind_addr
