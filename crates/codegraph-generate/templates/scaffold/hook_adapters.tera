/// Adapts the open SeaORM transaction to `HookTx`.
pub struct HookTxAdapter<'a>(pub &'a sea_orm::DatabaseTransaction);

#[async_trait]
impl {{ project.hooks_api_crate }}::generated::types::HookTx for HookTxAdapter<'_> {
