use std::any::Any;
use std::sync::Arc;

use async_trait::async_trait;
use cornucopia_queries::client::GenericClient;

use crate::db_client::{ClientSource, DbTx};

/// Adapts the open cornucopia transaction (`DbTx`) to `HookTx`. Borrows
/// the transaction — `Abort` rollback stays in the command layer's hands.
pub struct HookTxAdapter<'a, 'tx>(pub &'a DbTx<'tx>);

#[async_trait]
impl {{ project.hooks_api_crate }}::generated::types::HookTx for HookTxAdapter<'_, '_> {
    async fn execute(&self, sql: &str) -> Result<u64, String> {
        GenericClient::execute(self.0, sql, &[])
            .await
            .map_err(|e| e.to_string())
    }

    fn native(&self) -> &dyn Any {
        self
    }
}

/// Adapts the cornucopia `ClientSource` pool to `HookConnSource`: every
/// statement takes a fresh client and runs outside any command
/// transaction. Works on both targets (deadpool natively, Hyperdrive on
/// wasm32).
pub struct HookConnSourceAdapter(pub Arc<dyn ClientSource>);

#[async_trait]
impl {{ project.hooks_api_crate }}::generated::types::HookConnSource for HookConnSourceAdapter {
    async fn execute(&self, sql: &str) -> Result<u64, String> {
        let client = self.0.client().await.map_err(|e| e.to_string())?;
        GenericClient::execute(&client, sql, &[])
            .await
            .map_err(|e| e.to_string())
    }

    fn native(&self) -> &dyn Any {
        self
    }
}
