            ))
            .with_state(state);

        let addr: std::net::SocketAddr = std::env::var("BIND_ADDR")
            .unwrap_or_else(|_| "0.0.0.0:8787".to_string())
            .parse()
            .expect("BIND_ADDR must be a valid socket address (e.g. 0.0.0.0:8787)");
