        let upstream = match builder.body(body_bytes.to_vec()).send().await {
            Ok(resp) => resp,
            Err(e) => {
                return (
                    StatusCode::BAD_GATEWAY,
                    Json(serde_json::json!({
                        "error": {
                            "code": "BAD_GATEWAY",
