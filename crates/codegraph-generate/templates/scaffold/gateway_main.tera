    /// Forward a request to a domain worker, stripping the `/api/v1/{domain}`
    /// prefix. Upstream base URLs come from `GATEWAY_UPSTREAM_{BINDING}`.
    async fn forward(
        State(state): State<GatewayState>,
        Path((domain, path)): Path<(String, String)>,
        req: axum::extract::Request,
