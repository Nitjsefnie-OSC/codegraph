        let upstream_bytes = match upstream.bytes().await {
            Ok(bytes) => bytes,
            Err(e) => {
                return (
                    StatusCode::BAD_GATEWAY,
                    Json(serde_json::json!({
                        "error": {
                            "code": "BAD_GATEWAY",
                            "message": format!("failed to read upstream body: {e}"),
