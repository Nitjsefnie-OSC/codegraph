//! CORS for the {{ gateway_name }} gateway — mirrors the monolith's
//! `CORS_ALLOWED_ORIGINS` contract: unset = CORS disabled (same-origin
//! only), `*` = permissive, otherwise a comma-separated origin allow-list.
//! Dependency-free (axum http types only) so the same module compiles for
//! the native entrypoint and the wasm32 worker.
//! Generated by {{ project.generator_name }}. DO NOT EDIT.

use axum::http::{header, HeaderValue};

/// The resolved CORS configuration.
#[derive(Clone, Debug)]
pub struct Cors {
    allow_any_origin: bool,
    origins: Vec<String>,
}

impl Cors {
    /// Resolve from the raw `CORS_ALLOWED_ORIGINS` value (`None` = unset).
    pub fn resolve(value: Option<&str>) -> Self {
        match value {
            Some("*") => Self {
                allow_any_origin: true,
                origins: Vec::new(),
            },
            Some(raw) => Self {
                allow_any_origin: false,
                origins: raw
                    .split(',')
                    .map(|o| o.trim().to_string())
                    .filter(|o| !o.is_empty())
                    .collect(),
            },
            None => Self {
                allow_any_origin: false,
                origins: Vec::new(),
            },
        }
    }

    /// Whether any cross-origin request is served.
    pub fn enabled(&self) -> bool {
        self.allow_any_origin || !self.origins.is_empty()
    }

    /// The `Access-Control-Allow-Origin` value for a request origin: `*`
    /// when permissive, the echoed origin when allow-listed, `None`
    /// otherwise.
    fn allow_origin_for(&self, request_origin: Option<&HeaderValue>) -> Option<HeaderValue> {
        if self.allow_any_origin {
            return Some(HeaderValue::from_static("*"));
        }
        let origin = request_origin?;
        let origin_str = origin.to_str().ok()?;
        self.origins
            .iter()
            .any(|o| o.eq_ignore_ascii_case(origin_str))
            .then(|| origin.clone())
    }
}

/// The CORS response headers for a request, when CORS is enabled and the
/// request origin is allowed. `Vary: Origin` rides every allowed response
/// so caches do not collapse origins.
pub fn cors_headers(
    cors: &Cors,
    request_origin: Option<&HeaderValue>,
) -> Vec<(header::HeaderName, HeaderValue)> {
    let mut out = Vec::new();
    if let Some(origin) = cors.allow_origin_for(request_origin) {
        out.push((header::ACCESS_CONTROL_ALLOW_ORIGIN, origin));
        out.push((header::VARY, HeaderValue::from_static("Origin")));
        out.push((
            header::ACCESS_CONTROL_ALLOW_METHODS,
            HeaderValue::from_static("GET, POST, PUT, PATCH, DELETE, OPTIONS"),
        ));
        out.push((
            header::ACCESS_CONTROL_ALLOW_HEADERS,
            HeaderValue::from_static(
                "authorization, content-type, apikey, x-api-key, prefer",
            ),
        ));
        out.push((
            header::ACCESS_CONTROL_MAX_AGE,
            HeaderValue::from_static("86400"),
        ));
    }
    out
}

/// Whether the request is a CORS preflight: `OPTIONS` carrying
/// `Access-Control-Request-Method` (a plain `OPTIONS` route request must
/// still forward). Generic over the body type — the wasm gateway's requests
/// carry `worker::Body`, the native ones `axum::body::Body`.
pub fn is_preflight<B>(req: &axum::http::Request<B>) -> bool {
    req.method() == axum::http::Method::OPTIONS
        && req.headers().contains_key(header::ACCESS_CONTROL_REQUEST_METHOD)
}
