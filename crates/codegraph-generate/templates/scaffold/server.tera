//! Server startup logic.
//! Generated by codegraph. DO NOT EDIT.

use std::net::SocketAddr;
use std::sync::Arc;

use tokio_util::sync::CancellationToken;

use tracing_subscriber::layer::SubscriberExt;
use tracing_subscriber::util::SubscriberInitExt;
use tracing_subscriber::EnvFilter;
{% if not has_admin_cli %}use migration::MigratorTrait;
{% endif %}use utoipa::OpenApi;
use utoipa_swagger_ui::{SwaggerUi, Url};
use tower_http::cors::{Any, CorsLayer};
use tower_http::limit::RequestBodyLimitLayer;
use tower_http::set_header::SetResponseHeaderLayer;
use axum::http::HeaderValue;

static START_TIME: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();

/// Build and version metadata exposed at `GET /version`.
#[derive(serde::Serialize, utoipa::ToSchema)]
pub struct VersionInfo {
    pub version: &'static str,
    pub git_commit: &'static str,
    pub git_branch: &'static str,
    pub git_dirty: bool,
    pub build_time: &'static str,
    pub rust_version: &'static str,
    pub rust_channel: &'static str,
    pub cargo_version: &'static str,
    pub build_os: &'static str,
}

fn init_tracing() -> Option<opentelemetry_sdk::trace::SdkTracerProvider> {
    let fmt_layer = tracing_subscriber::fmt::layer().json();
    let filter = EnvFilter::try_from_default_env()
        .unwrap_or_else(|_| EnvFilter::new("info"));

    let registry = tracing_subscriber::registry()
        .with(filter)
        .with(fmt_layer);

    if std::env::var("OTEL_EXPORTER_OTLP_ENDPOINT").is_ok() {
        use opentelemetry::trace::TracerProvider;
        match opentelemetry_otlp::SpanExporter::builder()
            .with_tonic()
            .build()
        {
            Ok(exporter) => {
                let provider = opentelemetry_sdk::trace::SdkTracerProvider::builder()
                    .with_batch_exporter(exporter)
                    .build();
                let tracer = provider.tracer("{{ app_name }}");
                opentelemetry::global::set_tracer_provider(provider.clone());
                let otel_layer = tracing_opentelemetry::layer().with_tracer(tracer);
                registry.with(otel_layer).init();
                Some(provider)
            }
            Err(e) => {
                eprintln!("Failed to initialize OTel exporter (OTEL_EXPORTER_OTLP_ENDPOINT is set but exporter creation failed): {e}");
                registry.init();
                None
            }
        }
    } else {
        registry.init();
        None
    }
}

#[utoipa::path(
    get,
    path = "/version",
    tag = "System",
    responses(
        (status = 200, description = "Build and version information", body = VersionInfo)
    )
)]
async fn version() -> axum::Json<VersionInfo> {
    use shadow_rs::shadow;
    shadow!(build);
    axum::Json(VersionInfo {
        version: build::PKG_VERSION,
        git_commit: build::SHORT_COMMIT,
        git_branch: build::BRANCH,
        git_dirty: !build::GIT_CLEAN,
        build_time: build::BUILD_TIME_3339,
        rust_version: build::RUST_VERSION,
        rust_channel: build::RUST_CHANNEL,
        cargo_version: build::CARGO_VERSION,
        build_os: build::BUILD_OS,
    })
}

async fn health(
    axum::extract::State(state): axum::extract::State<crate::app_state::AppState>,
) -> axum::Json<serde_json::Value> {
    let db_ok = sea_orm::ConnectionTrait::execute_raw(
        &state.db,
        sea_orm::Statement::from_string(
            sea_orm::DatabaseBackend::Postgres,
            "SELECT 1",
        ),
    )
    .await
    .is_ok();
    axum::Json(serde_json::json!({
        "status": if db_ok { "ok" } else { "degraded" },
        "db": if db_ok { "connected" } else { "unreachable" },
    }))
}

async fn health_ready(
    axum::extract::State(state): axum::extract::State<crate::app_state::AppState>,
) -> axum::Json<serde_json::Value> {
    let db_ok = sea_orm::ConnectionTrait::execute_raw(
        &state.db,
        sea_orm::Statement::from_string(
            sea_orm::DatabaseBackend::Postgres,
            "SELECT 1",
        ),
    )
    .await
    .is_ok();

    // Check workflow definitions exist (informational, not a failure)
    let workflow_status = async {
        use sea_orm::{FromQueryResult, JsonValue};
        let result = JsonValue::find_by_statement(sea_orm::Statement::from_string(
            sea_orm::DatabaseBackend::Postgres,
            "SELECT count(*)::int AS cnt FROM platform.workflow_definition",
        ))
        .one(&state.db)
        .await
        .ok()
        .flatten();
        match result {
            Some(val) => {
                let cnt = val.get("cnt").and_then(|v| v.as_i64()).unwrap_or(0);
                if cnt > 0 { "ok" } else { "no_definitions" }
            }
            None => "no_definitions",
        }
    }.await;

    // Check RLS session vars can be set and read back within a transaction
    let rls_ok = async {
        use sea_orm::TransactionTrait;
        let tx = state.db.begin().await.ok()?;
        sea_orm::ConnectionTrait::execute_raw(
            &tx,
            sea_orm::Statement::from_string(
                sea_orm::DatabaseBackend::Postgres,
                "SELECT set_config('app.current_api_key', 'health-check', true)",
            ),
        ).await.ok()?;
        let readback = sea_orm::ConnectionTrait::query_one_raw(
            &tx,
            sea_orm::Statement::from_string(
                sea_orm::DatabaseBackend::Postgres,
                "SELECT current_setting('app.current_api_key') AS val",
            ),
        ).await.ok()?;
        let val: String = readback?.try_get("", "val").ok()?;
        tx.commit().await.ok()?;
        if val == "health-check" { Some(()) } else { None }
    }.await.is_some();

    let uptime_secs = START_TIME.get().map(|s| s.elapsed().as_secs()).unwrap_or(0);

    axum::Json(serde_json::json!({
        "status": if db_ok && rls_ok { "ok" } else { "degraded" },
        "db": if db_ok { "connected" } else { "unreachable" },
        "workflow": workflow_status,
        "rls": if rls_ok { "ok" } else { "error" },
        "uptime_seconds": uptime_secs,
    }))
}

/// Start the Axum HTTP server with graceful shutdown.
/// Handles tracing, DB connection, state construction, router
/// building, and signal handling.
pub async fn run_server() -> Result<(), Box<dyn std::error::Error>> {
{% if has_admin_cli %}
    let config = crate::config::ServerConfig::load(None)?;
    if std::env::var("RUST_LOG").is_err() {
        std::env::set_var("RUST_LOG", &config.log_level);
    }
{% endif %}
    let otel_provider = init_tracing();
    START_TIME.get_or_init(std::time::Instant::now);

    let metrics_handle = metrics_exporter_prometheus::PrometheusBuilder::new()
        .install_recorder()
        .map_err(|e| format!("Failed to install Prometheus metrics recorder: {e}"))?;

    let app_name = std::env::var("APP_NAME").unwrap_or_else(|_| "{{ app_name }}".to_string());

{% if has_admin_cli %}
    let db_url = config.database_url()?;
{% else %}
    let db_url = std::env::var("DATABASE_URL").map_err(|_| {
        {% if project.database_target == "sqlite" %}
        "DATABASE_URL environment variable is required. Set it to your SQLite database path, e.g. sqlite:///path/to/db.sqlite?mode=rwc"
        {% else %}
        "DATABASE_URL environment variable is required. Set it to your Postgres connection string, e.g. postgres://user:pass@host:5432/dbname"
        {% endif %}
    })?;
{% endif %}

    let db = sea_orm::Database::connect(&db_url).await?;

    // Apply pending migrations on startup. When the admin CLI is enabled the
    // app has src/migration.rs — the SAME engine `cosmos-app migrate` uses
    // (raw SQL files, dollar-quote-aware statement splitting, tracked in
    // schema_migrations). Sharing one engine and one tracking table keeps
    // boot idempotent against CLI runs — running the SeaORM Migrator here
    // instead would re-apply every file a CLI run already applied (its
    // seaql_migrations tracking is invisible to this runner) and die on the
    // first seeded codelist. Without the CLI module, fall back to the
    // always-generated SeaORM migration crate.
    {% if has_admin_cli %}
    if let Err(e) = crate::migration::run_migrations().await {
        tracing::error!("Failed to apply database migrations: {e}");
        return Err(e.into());
    }
    {% else %}
    if let Err(e) = migration::Migrator::up(&db, None).await {
        tracing::error!("Failed to apply database migrations: {e}");
        return Err(e.into());
    }
    {% endif %}

    // App pool (#169): when APP_DATABASE_URL is set, the serving pool connects
    // as the NOBYPASSRLS app_user role — request context rides the statement
    // payload and no per-transaction SET LOCAL ROLE is needed. Without it the
    // owner DATABASE_URL pool is shared and the data path falls back to the
    // legacy bundled-context delivery. Boot migrations above keep running on
    // the owner connection either way.
    {% if project.database_target == "postgres" %}
    let (app_db, pool_mode) = match std::env::var("APP_DATABASE_URL") {
        Ok(url) => (
            sea_orm::Database::connect(&url).await?,
            crate::app_state::DbPoolMode::AppUser,
        ),
        Err(_) => (db.clone(), crate::app_state::DbPoolMode::Legacy),
    };
    tracing::info!(mode = ?pool_mode, "database pool mode");
    {% else %}
    let (app_db, pool_mode) = (db.clone(), crate::app_state::DbPoolMode::Legacy);
    {% endif %}

{% if project.hooks_api_crate %}
    // Hook registry — lifecycle hooks + authz service. Built before AppState so
    // command/query handlers receive their per-entity lifecycle hook.
    let mut hooks_registry = {{ project.hooks_api_crate }}::HookRegistry::default();
{% if has_atproto %}
    hooks_registry.register_authorization(std::sync::Arc::new(
        cosmos_extensions::authorization::AuthorizationServiceImpl::new(db.clone()),
    ));
    cosmos_extensions::did_validation::register_did_validation_hooks(&mut hooks_registry);
{% endif %}
{% endif %}

{% if has_atproto %}
    // Application context for the hand-written HTTP layer (cosmos-extensions).
    // Builds the identity service, AT Protocol service auth and the OAuth
    // provider from the environment (AppContext::from_env — ATPROTO_* /
    // OAUTH_* / SUPABASE_JWT_SECRET) and shares the HookRegistry so the
    // hand-written auth / oauth / migration / identity routers can reach the
    // email adapter and the AuthorizationService.
    let app_ctx = cosmos_extensions::http::AppContext::from_env(
        db.clone(),
        {% if project.hooks_api_crate %}Some(std::sync::Arc::new(hooks_registry.clone())){% else %}None{% endif %},
    )?;

    {
        // Trust attestation verification (issue #43): cryptographically verify
        // the attestation signature before the row is created. Rejects
        // tampered signatures and unresolvable issuers with 422.
        hooks_registry.crm_trust_attestation = Some(std::sync::Arc::new(
            cosmos_extensions::trust_lifecycle::TrustAttestationLifecycleHook::from_app_context(
                app_ctx.as_ref(),
            ),
        ));
    }

    {
        // Issue #34: declare the accessibility labeler service (idempotent).
        // Best-effort: a did:web authority may not have a hosted repo, so a
        // failure to persist is logged, not fatal.
        if let (Some(labeler), Some(client)) =
            (app_ctx.labeler.clone(), app_ctx.atproto_client.clone())
        {
            let did = labeler.labeler_did().to_string();
            let declaration = serde_json::json!({
                "policies": { "labelValues": cosmos_extensions::labels::ALL_LABEL_VALUES },
                "createdAt": chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Secs, true),
            });
            tokio::spawn(async move {
                match client
                    .create_record_with_rkey("app.bsky.labeler.service", "self", &declaration)
                    .await
                {
                    Ok(_) => tracing::info!("declared labeler service for {}", did),
                    Err(e) => tracing::warn!("failed to declare labeler service: {}", e),
                }
            });
        }
    }
{% endif %}{% if project.has_extension_points %}
    // SeaORM monolith: the dispatcher shares the serving pool. Under
    // cornucopia (workers topology) each worker crate constructs its own
    // dispatcher from the ClientSource handle — the monolith carries None.
    let integration_dispatcher = {% if project.persistence_provider == "sea_orm" %}Some(std::sync::Arc::new(crate::integration_dispatch::IntegrationDispatcher::new(app_db.clone()))){% else %}None{% endif %};
{% endif %}

    let state = crate::app_state::AppState {
{% for domain in domains %}
{% for entity in domain.entities %}
{%- if entity.has_commands %}
        {{ domain.name }}_{{ entity.module_name }}_commands: crate::domain::{{ domain.name }}::{{ entity.module_name }}::command::{{ entity.name }}CommandHandler::new(
            Arc::new(crate::domain::{{ domain.name }}::{{ entity.module_name }}::repository_impl::{{ entity.name }}RepositoryImpl),
            app_db.clone(),
{% if project.hooks_api_crate %}
            hooks_registry.{{ domain.name }}_{{ entity.module_name }}.clone(),
{% endif %}{% if project.has_extension_points %}
            integration_dispatcher.clone(),
{% endif %}
        ),{% endif %}
        {{ domain.name }}_{{ entity.module_name }}_queries: crate::domain::{{ domain.name }}::{{ entity.module_name }}::query::{{ entity.name }}QueryHandler::new(
            Arc::new(crate::domain::{{ domain.name }}::{{ entity.module_name }}::repository_impl::{{ entity.name }}RepositoryImpl),
            app_db.clone(),
{% if project.hooks_api_crate %}
            hooks_registry.{{ domain.name }}_{{ entity.module_name }}.clone(),
{% endif %}
        ),
{% endfor %}
{% endfor %}
        db: app_db.clone(),
        pool_mode,
{% if project.has_extension_points %}
        integration_dispatcher,
{% endif %}
{% if project.hooks_api_crate %}
        registry: hooks_registry,
{% endif %}{% if has_atproto %}
        identity: app_ctx.identity.clone(),

        atproto_auth: app_ctx.atproto_auth.clone(),

        atproto_client: app_ctx.atproto_client.clone(),

        oauth_provider: app_ctx.oauth_provider.clone(),

{% endif %}
{% if has_admin_cli %}
        jwt_secret: config.jwt_secret()?,
{% else %}
        jwt_secret: std::env::var("SUPABASE_JWT_SECRET").map_err(|_| {
            "SUPABASE_JWT_SECRET environment variable is required. Set it to your Supabase project JWT secret"
        })?,
{% endif %}
        workflow_service: {
            let svc = std::sync::Arc::new(
                codegraph_workflow::engine::SeaOrmWorkflowService::new(db.clone())
            );
            svc
        },
    };

    // Graceful shutdown — CancellationToken broadcasts to all components
    let shutdown_token = CancellationToken::new();

    // Timer service
    let timer_service = codegraph_workflow::timer::TimerService::new(
        db.clone(),
        state.workflow_service.clone(),
        std::time::Duration::from_secs(30),
    );
    let timer_token = shutdown_token.child_token();
    tokio::spawn(async move { timer_service.run(timer_token).await });

{% if has_webhooks %}
    // Webhook dispatch worker
    let webhook_dispatcher = crate::webhook_dispatch::WebhookDispatcher::new(db.clone())?;
    let wd_token = shutdown_token.child_token();
    tokio::spawn(async move {
        webhook_dispatcher.run(wd_token).await;
    });
{% endif %}

{% if has_atproto %}
    // AT Protocol live-stream consumers. The rsky firehose is the durable
    // default; setting JETSTREAM_ENABLED=true swaps every per-domain consumer
    // to a Jetstream WebSocket (pre-decoded JSON, collection-filtered) that
    // emits the identical CommitEvent through the same persist sink.
    let firehose_url = std::env::var("FIREHOSE_URL")
        .unwrap_or_else(|_| "wss://bsky.network/xrpc".to_string());
    let use_jetstream = std::env::var("JETSTREAM_ENABLED")
        .map(|v| v == "1" || v.to_lowercase() == "true")
        .unwrap_or(false);
    let jetstream_url = std::env::var("JETSTREAM_URL")
        .unwrap_or_else(|_| cosmos_extensions::atproto::jetstream::DEFAULT_JETSTREAM_URL.to_string());
{% for domain in domains %}
{% if domain.entities | length > 0 %}
    {
        let db = db.clone();
        let firehose_url = firehose_url.clone();
        let jetstream_url = jetstream_url.clone();
        let fh_token = shutdown_token.child_token();
        tokio::spawn(async move {
            use crate::atproto::appview::ingest_{{ domain.name }};
            if use_jetstream {
                let mut client = cosmos_extensions::atproto::jetstream::JetstreamClient::new(
                    &jetstream_url,
                    &[{% for nsid in domain.atproto_nsids %}"{{ nsid }}"{% if not loop.last %}, {% endif %}{% endfor %}],
                )
                .expect("invalid JETSTREAM_URL");
                tracing::info!("Starting jetstream consumer for domain: {{ domain.name }}");
                tokio::select! {
                    _ = fh_token.cancelled() => {
                        tracing::info!("jetstream consumer shutting down: {{ domain.name }}");
                    }
                    _ = ingest_{{ domain.name }}::ingest_{{ domain.name }}(client, db) => {}
                }
                } else {
                    let mut firehose = crate::atproto::firehose::FirehoseClient::new(&firehose_url).unwrap();
                    tracing::info!("Starting firehose consumer for domain: {{ domain.name }}");
                    tokio::select! {
                        _ = fh_token.cancelled() => {
                            tracing::info!("firehose consumer shutting down: {{ domain.name }}");
                        }
                        _ = ingest_{{ domain.name }}::ingest_{{ domain.name }}(firehose, db) => {}
                    }
                }
            });
        }
{% endif %}
{% endfor %}
{% if has_labels %}
    {
        // AT Protocol labels subscriber (issue #33): consumes
        // com.atproto.label.subscribeLabels (#labels frames) and persists
        // applied labels into `atproto.label`. This is an independent consumer
        // (labels are free-standing data objects, not per-domain records), so
        // it spawns beside the record consumers with the same child_token +
        // tokio::select! graceful-shutdown pattern.
        let db = db.clone();
        let firehose_url = firehose_url.clone();
        let label_token = shutdown_token.child_token();
        let labeler = app_ctx.labeler.clone();
        let label_resolver: Option<std::sync::Arc<cosmos_extensions::http::identity::IdentityService>> =
            app_ctx.identity.as_ref().map(|id| std::sync::Arc::new(id.clone()));
        tokio::spawn(async move {
            let mut firehose = crate::atproto::firehose::FirehoseClient::new_labels(&firehose_url)
                .expect("invalid FIREHOSE_URL for label subscriber");
            tracing::info!("Starting label firehose consumer (com.atproto.label.subscribeLabels)");
            tokio::select! {
                _ = label_token.cancelled() => {
                    tracing::info!("label firehose consumer shutting down");
                }
                _ = cosmos_extensions::label_ingest::ingest_labels(
                    firehose,
                    db,
                    labeler,
                    label_resolver,
                ) => {}
            }
        });
    }
{% endif %}
{% endif %}

    let shutdown_signal = async move {
        #[cfg(unix)]
        {
            use tokio::signal::unix::{signal, SignalKind};
            let mut sigterm = signal(SignalKind::terminate())
                .expect("failed to install SIGTERM handler");
            let mut sigquit = signal(SignalKind::quit())
                .expect("failed to install SIGQUIT handler");
            tokio::select! {
                _ = tokio::signal::ctrl_c() => {
                    tracing::info!("received SIGINT, initiating graceful shutdown");
                }
                _ = sigterm.recv() => {
                    tracing::info!("received SIGTERM, initiating graceful shutdown");
                }
                _ = sigquit.recv() => {
                    tracing::info!("received SIGQUIT, initiating graceful shutdown");
                }
            }
        }
        #[cfg(not(unix))]
        {
            tokio::signal::ctrl_c().await.ok();
            tracing::info!("received SIGINT, initiating graceful shutdown");
        }
        shutdown_token.cancel();
    };

    // CORS configuration
    let cors = match std::env::var("CORS_ALLOWED_ORIGINS").as_deref() {
        Ok("*") => CorsLayer::very_permissive(),
        Ok(origins) => {
            let origins: Vec<HeaderValue> = origins
                .split(',')
                .filter_map(|o| o.trim().parse().ok())
                .collect();
            CorsLayer::new()
                .allow_origin(origins)
                .allow_methods(Any)
                .allow_headers(Any)
        }
        Err(_) => {
            tracing::warn!("CORS_ORIGINS not set — CORS disabled (no cross-origin requests allowed). Set CORS_ORIGINS=* to allow all.");
            CorsLayer::new()
        }
    };

    let api_routes = axum::Router::new()
{% for domain in domains %}
{% if domain.entities | length > 0 %}
        .nest("/{{ domain.name }}", crate::api::{{ domain.name }}::router::router())
{% endif %}
{% endfor %}
        .route("/integrations", axum::routing::get(crate::integrations::get_integrations))
{% if has_reports %}
        .nest("/reports", crate::api::report_router::report_routes())
{% endif %}
{% if has_webhooks %}
        .nest("/webhooks", crate::webhook_router::webhook_routes())
{% endif %}
{% if has_atproto and project.hooks_api_crate %}
        // Inject the registered AuthorizationService into request extensions so
        // the generated permission middleware can reach it without a State
        // extractor (route-level layers cannot access router state).
        .layer(axum::Extension(state.registry.authorization.clone()))
{% endif %}
        // API-key scope enforcement is DB-level (#169): the RESTRICTIVE
        // scope_enforced_* RLS policies enforce scopes in the same statement
        // that touches the data, so the permission middleware needs no pooled
        // DB connection extension.
{% if has_atproto %}
        .layer(axum::middleware::from_fn({
            let app_ctx = app_ctx.clone();
            move |request: axum::extract::Request, next: axum::middleware::Next| {
                cosmos_extensions::http::middleware::auth_middleware(
                    app_ctx.clone(),
                    request,
                    next,
                )
            }
        }));
{% else %}
        .layer(axum::middleware::from_fn_with_state(state.clone(), crate::middleware::auth_middleware));
{% endif %}

    // The whole router is assembled as `Router<()>`: the generated AppState
    // pieces (health, /api/v1 stack, per-domain XRPC routers) are closed with
    // `.with_state(state.clone())`, and the hand-written extension routers
    // (already `Router<()>` via `AppContext`) merge in directly.
    let app = axum::Router::new()

        .route("/version", axum::routing::get(version))
        .route("/health", axum::routing::get(health).with_state(state.clone()))
        .route("/health/ready", axum::routing::get(health_ready).with_state(state.clone()))
        .route("/metrics", axum::routing::get(move || std::future::ready(metrics_handle.render())))
        .nest("/api/{{ project.api_version }}", api_routes.with_state(state.clone()))
        .route("/api-catalog.json", axum::routing::get(crate::api::openapi::catalog::api_catalog))
        .merge(
            SwaggerUi::new("/swagger-ui")
                .urls(vec![
                    (Url::new("All", "/api-docs/openapi.json"), crate::api::openapi::all::AllApiDoc::openapi()),
{% for domain in domains %}
{% if domain.entities | length > 0 %}
                    (Url::new("{{ domain.label }}", "/api-docs/{{ domain.name }}/openapi.json"), crate::api::openapi::{{ domain.name }}::{{ domain.name | pascal_case }}ApiDoc::openapi()),
{% endif %}
{% endfor %}
                ])
        )

        // ── Hand-written extension routes (cosmos-extensions) ──
        // The auth / oauth / identity / migration / oauth-admin / platform /
        // well-known / XRPC-identity routers are hand-written extension code
        // (cosmos_extensions::http::*) built against a single `Arc<AppContext>`
        // and closed to `Router<()>` inside the crate.
{% if has_atproto %}
        .merge(cosmos_extensions::http::well_known_routes(app_ctx.clone()))
        .nest("/auth", cosmos_extensions::http::auth_routes(app_ctx.clone()))
        .merge(cosmos_extensions::http::oauth_routes(app_ctx.clone()))
        .route(
            "/api-docs/oauth/openapi.json",
            axum::routing::get(cosmos_extensions::http::auth::oauth_openapi::oauth_openapi_json),
        )
        .nest(
            "/api/identity",
            cosmos_extensions::http::identity_admin_routes(app_ctx.clone()),
        )
        // Email-claim ownership for unconfirmed person records (issue #74).
        .nest(
            "/api/claims",
            cosmos_extensions::http::claims_routes(app_ctx.clone()),
        )
        .nest(
            "/api/migration",
            cosmos_extensions::http::migration_routes(app_ctx.clone()),
        )
        .nest(
            "/api/oauth-admin",
            cosmos_extensions::http::oauth_admin_routes(app_ctx.clone()),
        )
        .nest(
            "/api/v1/platform",
            cosmos_extensions::http::platform_routes(app_ctx.clone()),
        )
         .merge(crate::atproto::xrpc::xrpc_routes().with_state(state.clone()))
         .merge(cosmos_extensions::http::xrpc_identity_routes(app_ctx.clone()))
         // XRPC labels (issue #34) + push (issue #40): hand-written extension
         // routers with full /xrpc paths, merged at the app root.
         .merge(cosmos_extensions::http::xrpc_labels_routes(app_ctx.clone()))
         .merge(cosmos_extensions::http::xrpc_push_routes(app_ctx.clone()))
         // Labeler admin issuance (issue #34): POST /api/admin/labels.
         .merge(cosmos_extensions::http::label_admin_routes(app_ctx.clone()))
         // Trust transitivity (issue #43): /api/community_graph/trust-path.
         // NOTE: deliberately NOT under /api/v1/community_graph — that prefix
         // is owned by the generated domain router (nested inside /api/v1) and
         // double-nesting the same prefix drops extension routes (axum).
         .nest(
             "/api/community_graph",
             cosmos_extensions::http::trust_routes(app_ctx.clone()),
         )
         // Starter packs (issue #44): /api/v1/onboarding/starter-pack/*.
         .nest(
             "/api/v1/onboarding/starter-pack",
             cosmos_extensions::http::onboarding_routes(app_ctx.clone()),
         )
         // Embedded space authority (issue #39, teaser — bearer flow):
         // /xrpc/com.atproto.space.{getSpaceCredential,getDelegationToken,getSpace,listRepos}.
         // Armed from SPACE_AUTHORITY_DID / SPACE_SIGNING_KEY_HEX /
         // SPACE_CREDENTIAL_TTL_SECS; the consent-backed care-circle policy
         // consults the delegation/consent/support tables.
         .merge(cosmos_extensions::space::http::space_routes(app_ctx.clone()))
         // XRPC resource-server auth (issue #36 Wave C sub-task 12): accepts
         // OAuth DPoP-bound access tokens alongside the AT Protocol service JWT
         // and TEST_MODE persona paths, injecting AtprotoDid into extensions.
         .layer(axum::middleware::from_fn({
             let app_ctx = app_ctx.clone();
             move |request: axum::extract::Request, next: axum::middleware::Next| {
                 cosmos_extensions::http::auth::oauth_middleware::oauth_xrpc_auth(
                     app_ctx.clone(),
                     request,
                     next,
                 )
             }
         }))
{% endif %}
         ;

    // --- END GENERATED ---

    // Merge custom extension routes (Router<()>) after .with_state()
{% if ext_points %}
    let app = custom_routes.into_iter().fold(app, |app, (prefix, router)| {
        app.nest(&prefix, router)
    });
{% endif %}

    let app = app
        .layer(axum::middleware::from_fn(crate::metrics_middleware::track_metrics))
        .layer(cors)
        .layer(RequestBodyLimitLayer::new(10 * 1024 * 1024)) // 10MB
        // Security response headers — applied to every response via
        // SetResponseHeaderLayer::overriding (one layer per header).
                .layer(SetResponseHeaderLayer::overriding(
            axum::http::header::HeaderName::from_static("x-content-type-options"),
            HeaderValue::from_static("nosniff"),
        ))
        .layer(SetResponseHeaderLayer::overriding(
            axum::http::header::HeaderName::from_static("x-frame-options"),
            HeaderValue::from_static("SAMEORIGIN"),
        ))
        .layer(SetResponseHeaderLayer::overriding(
            axum::http::header::HeaderName::from_static("referrer-policy"),
            HeaderValue::from_static("strict-origin-when-cross-origin"),
        ))
        .layer(SetResponseHeaderLayer::overriding(
            axum::http::header::HeaderName::from_static("permissions-policy"),
            HeaderValue::from_static("camera=(), microphone=(), geolocation=()"),
        ))
        .layer(SetResponseHeaderLayer::overriding(
            axum::http::header::HeaderName::from_static("content-security-policy"),
            HeaderValue::from_static("default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self'; font-src 'self' data:"),
        ));

    // HSTS — only when explicitly enabled (production with TLS termination)
    let app = if std::env::var("HSTS_ENABLED").as_deref() == Ok("true") {
        app.layer(SetResponseHeaderLayer::overriding(
            axum::http::header::HeaderName::from_static("strict-transport-security"),
            HeaderValue::from_static("max-age=31536000; includeSubDomains"),
        ))
    } else {
        app
    };

{% if has_admin_cli %}
    let addr: SocketAddr = config
        .bind_addr
        .parse()
        .map_err(|_| "bind_addr must be a valid socket address (e.g. 0.0.0.0:3000 or 127.0.0.1:8080)")?;
{% else %}
    let addr: SocketAddr = std::env::var("BIND_ADDR")
        .unwrap_or_else(|_| "0.0.0.0:3000".to_string())
        .parse()
        .expect("BIND_ADDR must be a valid socket address (e.g. 0.0.0.0:3000 or 127.0.0.1:8080)");
{% endif %}
    tracing::info!(app_name = %app_name, "Swagger UI: http://{addr}/swagger-ui/  |  API Catalog: http://{addr}/api-catalog.json");
    tracing::info!("Listening on http://{addr}");
    let listener = tokio::net::TcpListener::bind(addr).await?;
    axum::serve(listener, app)
        .with_graceful_shutdown(shutdown_signal)
        .await?;

    // Flush OTel traces before exit
    if let Some(provider) = otel_provider {
        if let Err(e) = provider.shutdown() {
            eprintln!("OTel shutdown error: {e}");
        }
    }

    Ok(())
}
