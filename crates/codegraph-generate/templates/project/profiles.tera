# {{ project_name }} generation profiles — generated by `codegraph init`.
#
# Feature flags gate generator families. gRPC/IFML generators are only listed
# when their backend feature is enabled (BuildPlan rejects generators whose
# required features are off) — re-run `codegraph init` with --grpc/--ifml to
# toggle them.

[profiles.default.meta]
name = "default"
version = "0.1.0"
description = "Default generation profile for {{ project_name }}"
app_name = "{{ app_name }}"
generator_name = "{{ graph_binary }}"
api_title = "{{ api_title }}"
domain_types_crate = "{{ app_name }}_domain_types"
# Generated support crates live inside the output dir; move these to
# repo-root workspace members (hr-specs pattern) once you hand-write code.
domain_types_base = "crates/domain-types"

[profiles.default.features]
database_target = "{{ database_target }}"
persistence_provider = "{{ persistence_provider }}"
deployment_topology = "{{ deployment_topology }}"
{% if dependency_strategy_path %}# Local development: the generated app references this checkout's
# codegraph crates by absolute path (issue #347).
dependency_strategy = "path"
{% endif %}ops_backend = {{ features.ops }}
grpc_backend = {{ features.grpc }}
ifml_backend = {{ features.ifml }}
{% if features.rosetta %}rosetta_backend = true
{% endif %}has_admin_cli = true
# UX rules plane (issue #293): the built-in ux-default pack resolves into
# ProjectConfig.ux; override per project with `--ux-rules <file>`.
ux_rules = true

[profiles.default.api]
generators = [
    # Entity
    "ddl", "sea_orm_entity", "codelist", "dto", "repository", "command",
    "query", "event", "handler", "workflow_action", "media_route", "test",
    "lifecycle_trait", "domain_types_dto", "domain_types_query_service",
    # Domain
    "router", "links", "errors", "mox_ops",
    # hurl API contract tests (issue #463) — run by the ops api suite
    "hurl_contract",
    # Global
    "openapi", "scaffold", "basejump_setup", "pgmq_setup",
    "platform_schema", "workflow_seed", "hook_registry", "domain_types_scaffold",
    "report_views",
    "webhook_dispatch", "webhook_endpoint_api",
{% if features.grpc %}
    # gRPC
    "grpc_proto", "grpc_service", "grpc_router", "grpc_scaffold",
{% endif %}
{% if features.ops %}
    # Ops harness
    "ops",
{% endif %}
]
output = "generated/"
scripts.post_gen = []

[profiles.default.ui]
generators = [
    # Entity
    "ui_page", "ui_form", "ui_store", "ui_e2e_test",
    "playwright-entity", "ui_descriptor", "ui-shell",
    # Domain
    "ui-domain-layout",
    # Global
    "ui_scaffold", "ui_types", "ui_codelist", "ui_orgchart", "playwright-global",
{% if features.ifml %}
    # IFML
    "ifml_route", "ifml_navigation",
{% endif %}
]
output = "generated/"
scripts.post_gen = []

[profiles.default.cli]
generators = ["cli_command", "cli_domain", "cli_scaffold"]
output = "generated/"
scripts.post_gen = []
