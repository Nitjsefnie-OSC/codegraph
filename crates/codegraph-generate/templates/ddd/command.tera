                set_config('app.correlation_id', '{}', true), \
                set_config('app.user_id', '{}', true), \
                set_config('app.role', '{}', true); \
         SET LOCAL ROLE app_user",
        api_key_id,
        api_key_id,
        organization_id,
        correlation_id,
        user_id,
        role.replace('\'', "''"),
    );
    tx.execute_unprepared(&sql).await?;
    Ok(())
}
