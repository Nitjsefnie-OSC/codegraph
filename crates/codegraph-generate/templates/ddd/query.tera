/// Set API key + org + user request context within a transaction so Postgres
/// RLS policies can enforce tenant isolation and scope checks (#169). The
/// whole bundle — every `set_config(..., true)` plus the role flip — rides a
/// SINGLE simple-query payload: one round trip per operation. Values are
/// server-side UUIDs, inlined with quotes escaped (the simple protocol takes
/// no bind parameters); `SET LOCAL ROLE app_user` is a no-op when the pool
/// already connects as app_user.
{% if project.persistence_provider == "cornucopia" %}
async fn set_rls_session_vars(
    tx: &impl client::GenericClient,
    api_key_id: Uuid,
    organization_id: Uuid,
    user_id: Uuid,
    role: &str,
) -> Result<(), {{ domain | pascal_case }}Error> {
    // Cornucopia's GenericClient is extended-protocol only (no simple-query
    // multi-statement), so the whole context batch rides ONE parameterised
    // execute and the role flip is a second statement.
    tx.execute(
        "SELECT set_config($1, $2, true), set_config($3, $4, true), \
                set_config($5, $6, true), set_config($7, $8, true), \
                set_config($9, $10, true)",
        &[
            &"app.current_api_key",
            &api_key_id.to_string(),
            &"app.current_api_key_id",
            &api_key_id.to_string(),
            &"app.organization_id",
            &organization_id.to_string(),
            &"app.user_id",
            &user_id.to_string(),
            &"app.role",
            &role.to_string(),
        ],
    )
    .await?;
    tx.execute("SET LOCAL ROLE app_user", &[]).await?;
    Ok(())
}
