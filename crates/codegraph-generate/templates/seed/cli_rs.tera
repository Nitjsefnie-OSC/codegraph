//! Demo-data seed CLI.
//! Generated by {{ project.generator_name }}. DO NOT EDIT.
//!
//! Dry-run needs no database:
//!   cargo run --bin seed -- --dry-run --company retail
//! Real run (DATABASE_URL must point at a migrated database):
//!   cargo run --bin seed -- --company retail --org <uuid> --seed 42

use std::sync::Arc;

use clap::Parser;
use hr_seed::{SeedOptions, SeedService};
use uuid::Uuid;

#[derive(Parser)]
#[command(name = "seed", about = "Seed demo data into an organization")]
struct Cli {
    /// Company provider: display name or industry name (e.g. "retail").
    #[arg(long)]
    company: String,

    /// Target organization UUID (required unless --dry-run).
    #[arg(long)]
    org: Option<Uuid>,

    /// Deterministic seed for the fake-data generator.
    #[arg(long, default_value_t = 42)]
    seed: u64,

    /// Approximate employee headcount.
    #[arg(long, default_value_t = 30)]
    employees: u32,

    /// Number of pay runs to generate.
    #[arg(long, default_value_t = 2)]
    pay_runs: u32,

    /// Days of history for timecards/payroll.
    #[arg(long, default_value_t = 90)]
    history_days: u32,

    /// Days of future schedule/leave.
    #[arg(long, default_value_t = 30)]
    future_days: u32,

    /// Skip leave requests.
    #[arg(long)]
    no_leave: bool,

    /// Skip timesheets.
    #[arg(long)]
    no_timesheets: bool,

    /// Skip benefits enrollments.
    #[arg(long)]
    no_benefits: bool,

    /// Skip credentials/certifications.
    #[arg(long)]
    no_credentials: bool,

    /// Inject compliance edge cases (expiring credentials, overlapping leave).
    #[arg(long)]
    compliance_edge_cases: bool,

    /// Generate and print counts without touching a database.
    #[arg(long)]
    dry_run: bool,

    /// Postgres connection string (falls back to DATABASE_URL).
    #[arg(long, env = "DATABASE_URL")]
    database_url: Option<String>,

    /// API key id passed to RLS session variables.
    #[arg(long, default_value_t = Uuid::nil())]
    api_key_id: Uuid,

    /// User id passed to RLS session variables.
    #[arg(long, default_value_t = Uuid::nil())]
    user_id: Uuid,
}

fn die(msg: &str) -> ! {
    eprintln!("fatal: {msg}");
    std::process::exit(1);
}

fn row(label: &str, count: usize) {
    println!("{label:<28} {count:>8}");
}

#[tokio::main]
async fn main() {
    tracing_subscriber::fmt::init();
    let cli = Cli::parse();

    let Some(provider) = hr_seed::companies::find_company(&cli.company) else {
        let names: Vec<&str> = hr_seed::companies::builtin_companies()
            .iter()
            .map(|p| p.display_name())
            .collect();
        die(&format!(
            "unknown company \"{}\" — available: {}",
            cli.company,
            names.join(", ")
        ));
    };

    let opts = SeedOptions::default()
        .with_employee_count(cli.employees)
        .with_pay_run_count(cli.pay_runs)
        .with_history_days(cli.history_days)
        .with_future_days(cli.future_days)
        .with_include_leave(!cli.no_leave)
        .with_include_timesheets(!cli.no_timesheets)
        .with_include_benefits(!cli.no_benefits)
        .with_include_credentials(!cli.no_credentials)
        .with_compliance_edge_cases(cli.compliance_edge_cases);

    if cli.dry_run {
        let output = match SeedService::dry_run(provider.as_ref(), &opts, cli.seed) {
            Ok(output) => output,
            Err(e) => die(&format!("dry-run failed: {e}")),
        };
        println!(
            "dry run for \"{}\" ({}), seed {}:",
            provider.display_name(),
            provider.industry().label(),
            cli.seed
        );
        println!("{entity:<28} {count:>8}", entity = "entity", count = "count");
        row("organizations", output.common.organizations.len());
        row("persons", output.common.persons.len());
        row("workers", output.common.workers.len());
        row("positions", output.common.positions.len());
        row("certifications", output.common.certifications.len());
        row("work_assignments", output.common.work_assignments.len());
        row("deployments", output.common.deployments.len());
        row(
            "compensations",
            output.domains.compensation.compensations.len(),
        );
        row("payroll_setups", output.domains.payroll.payroll_setups.len());
        row(
            "payroll_instructions",
            output.domains.payroll.payroll_instructions.len(),
        );
        row(
            "payment_instructions",
            output.domains.payroll.payment_instructions.len(),
        );
        row("enrollments", output.domains.benefits.enrollments.len());
        row("elections", output.domains.benefits.elections.len());
        row("dependents", output.domains.benefits.dependents.len());
        row("timecards", output.domains.timecard.timecards.len());
        row(
            "leave_requests",
            output.domains.timecard.leave_requests.len(),
        );
        row(
            "timecard_pay_rates",
            output.domains.timecard.timecard_pay_rates.len(),
        );
        row("candidates", output.domains.recruiting.candidates.len());
        row(
            "position_openings",
            output.domains.recruiting.position_openings.len(),
        );
        row("job_postings", output.domains.recruiting.job_postings.len());
        row("screening_orders", output.domains.screening.orders.len());
        row("screenings", output.domains.screening.screenings.len());
        row(
            "screening_reports",
            output.domains.screening.screening_reports.len(),
        );
        row(
            "asynchronous_orders",
            output.domains.interviewing.asynchronous_orders.len(),
        );
        row(
            "synchronous_orders",
            output.domains.interviewing.synchronous_orders.len(),
        );
        row("interviews", output.domains.interviewing.interviews.len());
        row(
            "assessment_catalogs",
            output.domains.assessments.assessment_catalogs.len(),
        );
        row("assessments", output.domains.assessments.assessments.len());
        row(
            "assessment_reports",
            output.domains.assessments.assessment_reports.len(),
        );
        row("wellness", output.domains.wellness.wellness.len());
        println!(
            "{:<28} {:>8}",
            "total",
            output.common.total_entities() + output.domains.total_entities()
        );
        return;
    }

    let Some(organization_id) = cli.org else {
        die("--org <uuid> is required unless --dry-run is set");
    };

    let db_url = match cli.database_url.clone() {
        Some(url) if !url.is_empty() => url,
        _ => match std::env::var("DATABASE_URL") {
            Ok(url) if !url.is_empty() => url,
            _ => die("DATABASE_URL is required (or pass --database-url)"),
        },
    };

    let mut db_opts = sea_orm::ConnectOptions::new(db_url.clone());
    db_opts.max_connections(10);
    let db = match sea_orm::Database::connect(db_opts).await {
        Ok(db) => db,
        Err(e) => die(&format!("database connect failed: {e}")),
    };

    let integrations_config = match hr_config::load() {
        Ok(config) => Arc::new(config),
        Err(e) => die(&format!("integration configuration is invalid: {e}")),
    };

    let mut registry = hr_hooks_api::HookRegistry::new();
    hr_extensions::register(&mut registry, &integrations_config, db.clone());
    let registry = Arc::new(registry);

{% if project.persistence_provider == "cornucopia" %}
    let mut pg_cfg = deadpool_postgres::Config::new();
    pg_cfg.url = Some(db_url);
    let pool: deadpool_postgres::Pool = match pg_cfg.create_pool(
        Some(deadpool_postgres::Runtime::Tokio1),
        deadpool_postgres::tokio_postgres::NoTls,
    ) {
        Ok(pool) => pool,
        Err(e) => die(&format!("failed to create postgres pool: {e}")),
    };
    let client_source: Arc<dyn {{ project.lib_name }}::db_client::ClientSource> =
        Arc::new({{ project.lib_name }}::db_client::DeadpoolClientSource::new(pool.clone()));
{% endif %}

    let workflow_service: Arc<dyn codegraph_workflow::WorkflowService> = Arc::new(
        codegraph_workflow::engine::SeaOrmWorkflowService::new(db.clone()),
    );

    let state = {{ project.lib_name }}::app_state::AppState {
{% for domain in domains %}
{% for entity in domain.entities %}
{% if entity.has_commands %}
        {{ domain.name }}_{{ entity.module_name }}_commands: {{ project.lib_name }}::domain::{{ domain.name }}::{{ entity.module_name }}::command::{{ entity.name }}CommandHandler::new(
{% if project.persistence_provider == "cornucopia" %}
            Arc::new({{ project.lib_name }}::domain::{{ domain.name }}::{{ entity.module_name }}::cornucopia_repository_impl::{{ entity.name }}RepositoryImpl),
            client_source.clone(),
            db.clone(),
{% else %}
            Arc::new({{ project.lib_name }}::domain::{{ domain.name }}::{{ entity.module_name }}::repository_impl::{{ entity.name }}RepositoryImpl),
            db.clone(),
{% endif %}
            registry.{{ domain.name }}_{{ entity.module_name }}.clone(),{% if project.has_extension_points %}
            None,
{% endif %}
        ),
{% endif %}
        {{ domain.name }}_{{ entity.module_name }}_queries: {{ project.lib_name }}::domain::{{ domain.name }}::{{ entity.module_name }}::query::{{ entity.name }}QueryHandler::new(
{% if project.persistence_provider == "cornucopia" %}
            Arc::new({{ project.lib_name }}::domain::{{ domain.name }}::{{ entity.module_name }}::cornucopia_repository_impl::{{ entity.name }}RepositoryImpl),
            client_source.clone(),
            db.clone(),
{% else %}
            Arc::new({{ project.lib_name }}::domain::{{ domain.name }}::{{ entity.module_name }}::repository_impl::{{ entity.name }}RepositoryImpl),
            db.clone(),
{% endif %}
{% if entity.has_query_hooks %}
            registry.{{ domain.name }}_{{ entity.module_name }}.clone(),
{% endif %}
        ),
{% endfor %}
{% endfor %}
        db: db.clone(),
{% if project.persistence_provider == "cornucopia" %}
        pool: pool.clone(),
        client_source: client_source.clone(),
{% endif %}
        jwt_secret: std::env::var("SUPABASE_JWT_SECRET").unwrap_or_else(|_| "seed-cli-unused".to_string()),
        workflow_service,
        registry: registry.clone(),
        compliance_engine: Arc::new(hr_compliance::engine::ComplianceEngine::new()),
        integrations_config: integrations_config.clone(),
    };

    let sink = {{ project.lib_name }}::seed::AppStateSeedSink::new(Arc::new(state))
        .with_api_key_id(cli.api_key_id)
        .with_user_id(cli.user_id);

    let summary =
        match SeedService::seed_into_org(&sink, organization_id, provider.as_ref(), &opts, cli.seed)
            .await
        {
            Ok(summary) => summary,
            Err(e) => die(&format!("seed failed: {e}")),
        };

    println!(
        "seeded \"{}\" ({}) into {organization_id} in {}ms (seed {})",
        summary.company_name,
        summary.industry_label,
        summary.duration_ms,
        cli.seed
    );
    let p = &summary.persisted;
    row("organizations", p.organizations);
    row("persons", p.persons);
    row("workers", p.workers);
    row("positions", p.positions);
    row("certifications", p.certifications);
    row("work_assignments", p.work_assignments);
    row("deployments", p.deployments);
    row("compensations", p.compensations);
    row("payroll_setups", p.payroll_setups);
    row("payroll_instructions", p.payroll_instructions);
    row("payment_instructions", p.payment_instructions);
    row("enrollments", p.enrollments);
    row("elections", p.elections);
    row("dependents", p.dependents);
    row("timecards", p.timecards);
    row("leave_requests", p.leave_requests);
    row("timecard_pay_rates", p.timecard_pay_rates);
    row("candidates", p.candidates);
    row("position_openings", p.position_openings);
    row("job_postings", p.job_postings);
    row("screening_orders", p.screening_orders);
    row("screenings", p.screenings);
    row("screening_reports", p.screening_reports);
    row("asynchronous_orders", p.asynchronous_orders);
    row("synchronous_orders", p.synchronous_orders);
    row("interviews", p.interviews);
    row("assessment_catalogs", p.assessment_catalogs);
    row("assessments", p.assessments);
    row("assessment_reports", p.assessment_reports);
    row("wellness", p.wellness);
    row("total persisted", summary.persisted_entities);
    println!("{:<28} {:>8}", "expected", summary.expected_entities);
}
