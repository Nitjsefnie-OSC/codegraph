import type { PageLoad } from './$types';
{% if has_fetch %}
import { error } from '@sveltejs/kit';
{% endif %}
{%- if view_roles or view_requires %}
import { redirect } from '@sveltejs/kit';
{%- if not integrated %}
import { browser } from '$app/environment';
{%- endif %}
{%- if view_roles %}
import { currentRoles } from '$lib/roles';
{%- endif %}
{%- if view_requires %}
import { can } from '$lib/roles';
{%- endif %}
{%- if guard_consts %}

{{ guard_consts }}
{%- endif %}
{%- endif %}
export const load: PageLoad = async ({ params, url, fetch{% if integrated and (view_roles or view_requires) %}, parent{% endif %} }) => {
{%- if view_roles or view_requires %}
{%- if integrated %}
	// Server-decided gating (issue #468 W-a): the (views)/+layout.server.ts
	// load resolves the session's role tokens — null when sessionless — so
	// the redirect fires DURING SSR, before any data fetch. A denied
	// persona never sees the guarded page; an allowed one hydrates with
	// the data already loaded. currentRoles() (the hydrated global, seeded
	// by persona init scripts) is the client-side fallback.
{%- if view_roles %}
	const parentData = (await parent()) as { roles?: string[] | null } | undefined;
	const roles: string[] = parentData?.roles ?? currentRoles();
{%- endif %}
{%- if view_requires %}
	if (viewRequires.length && !viewRequires.some((c) => can(c))) {
		throw redirect(303, '{{ denial_target }}');
	}
{%- endif %}
{%- if view_roles %}
	if (viewRoles.length && !roles.some((r) => viewRoles.includes(r))) {
		throw redirect(303, '{{ denial_target }}');
	}
{%- endif %}
{%- else %}
{%- if view_roles %}
	const roles = currentRoles();
{%- endif %}
{%- if view_requires %}
	if (browser && viewRequires.length && !viewRequires.some((c) => can(c))) {
		throw redirect(303, '{{ denial_target }}');
	}
{%- endif %}
{%- if view_roles %}
	if (browser && viewRoles.length && !roles.some((r) => viewRoles.includes(r))) {
		throw redirect(303, '{{ denial_target }}');
	}
{%- endif %}
{%- endif %}
{%- endif %}
	const result: Record<string, {% if has_workflow %}any{% else %}unknown{% endif %}> = {};
{%- if view_params %}
	const viewParams: Record<string, string> = {};
{%- for p in view_params %}
	viewParams['{{ p.name }}'] = url.searchParams.get('{{ p.name }}'){% if p.default %} ?? {{ p.default }}{% else %} ?? ''{% endif %};
{%- endfor %}
	result.params = viewParams;
{%- endif %}
{% for comp in components %}
{%- if comp.fetch_list %}
	const {{ comp.name }}Response = await fetch(`{{ comp.api.base_path }}{% if comp.paginate %}?page=${url.searchParams.get('page') ?? '0'}&page_size=${url.searchParams.get('page_size') ?? '20'}{% endif %}`);
	if (!{{ comp.name }}Response.ok) {
		error({{ comp.name }}Response.status, 'Failed to load {{ comp.entity | lower }}');
	}
	const {{ comp.name }}Data = await {{ comp.name }}Response.json();
	result.items = Array.isArray({{ comp.name }}Data) ? {{ comp.name }}Data : {{ comp.name }}Data.data ?? [];
{%- elif comp.fetch_item %}
	const {{ comp.id_param }} = viewParams['{{ comp.id_param }}'];
	if ({{ comp.id_param }}) {
		const {{ comp.name }}Response = await fetch(`{{ comp.api.base_path }}/${ {{ comp.id_param }} }`);
		if (!{{ comp.name }}Response.ok) {
			error({{ comp.name }}Response.status, 'Failed to load {{ comp.entity | lower }}');
		}
		const {{ comp.name }}Json = await {{ comp.name }}Response.json();
		const {{ comp.name }}Item = {{ comp.name }}Json.data ?? {{ comp.name }}Json;
{%- if comp.workflow %}
		const {{ comp.name }}WfResponse = await fetch(`{{ comp.api.base_path }}/${ {{ comp.id_param }} }/workflow`);
		if ({{ comp.name }}WfResponse.ok) {
			const {{ comp.name }}WfJson = await {{ comp.name }}WfResponse.json();
			{{ comp.name }}Item.workflow_state = {{ comp.name }}WfJson.data ?? {{ comp.name }}WfJson;
		}
{%- endif %}
		result.item = {{ comp.name }}Item;
	}
{%- elif comp.fetch_form %}
	const {{ comp.id_param }} = viewParams['{{ comp.id_param }}'];
	if ({{ comp.id_param }}) {
		const {{ comp.name }}Response = await fetch(`{{ comp.api.base_path }}/${ {{ comp.id_param }} }`);
		if (!{{ comp.name }}Response.ok) {
			error({{ comp.name }}Response.status, 'Failed to load {{ comp.entity | lower }}');
		}
		const {{ comp.name }}Json = await {{ comp.name }}Response.json();
		const {{ comp.name }}Data = {{ comp.name }}Json.data ?? {{ comp.name }}Json;
{%- if comp.workflow %}
		const {{ comp.name }}WfResponse = await fetch(`{{ comp.api.base_path }}/${ {{ comp.id_param }} }/workflow`);
		if ({{ comp.name }}WfResponse.ok) {
			const {{ comp.name }}WfJson = await {{ comp.name }}WfResponse.json();
			{{ comp.name }}Data.workflow_state = {{ comp.name }}WfJson.data ?? {{ comp.name }}WfJson;
		}
{%- endif %}
		result.formData = {{ comp.name }}Data;
	}
{%- endif %}
{%- endfor %}

	return result;
};
