/// The OPEN transaction, erased (issue #509). The generated command layer
/// adapts the provider's transaction to this SPI — `sea_orm::
/// DatabaseTransaction` on the monolith, the cornucopia `DbTx` in
/// workers. An `Abort` from a hook rolls the transaction back on every
/// provider. `native()` downcasts to the provider handle for consumers
/// that dep it directly.
#[async_trait]
pub trait HookTx: Send + Sync {
    /// Execute raw SQL inside the open transaction.
    async fn execute(&self, sql: &str) -> Result<u64, String>;
    /// The provider-native transaction handle (downcast hatch).
    fn native(&self) -> &dyn Any;
}

/// A connection source for post-commit / query-time work, erased. sea_orm
/// wraps `DatabaseConnection`; cornucopia wraps the `ClientSource` pool —
/// every statement takes a fresh client and runs OUTSIDE any command
/// transaction (native deadpool natively, Hyperdrive on wasm32).
#[async_trait]
pub trait HookConnSource: Send + Sync {
    /// Execute raw SQL on a fresh connection.
    async fn execute(&self, sql: &str) -> Result<u64, String>;
    /// The provider-native connection handle (downcast hatch).
    fn native(&self) -> &dyn Any;
}

/// Context for transactional hooks (`before_*`, `after_*_tx`). Runs
/// inside the open transaction; returning
/// `HookControl::Abort { .. }` rolls it back.
pub struct TxContext<'a> {
    tx: &'a dyn HookTx,
    pub organization_id: Uuid,
    pub correlation_id: Uuid,
    pub api_key_id: Uuid,
    pub source: SourceContext,
}

impl<'a> TxContext<'a> {
    pub fn new(
        tx: &'a dyn HookTx,
        correlation_id: Uuid,
        organization_id: Uuid,
        api_key_id: Uuid,
        source: &SourceContext,
    ) -> Self {
        Self {
            tx,
            organization_id,
            correlation_id,
            api_key_id,
            source: source.clone(),
        }
    }

    /// Execute raw SQL inside the open transaction.
    pub async fn execute(&self, sql: &str) -> Result<u64, String> {
        self.tx.execute(sql).await
    }

    /// The provider-native transaction handle (downcast hatch).
    pub fn native(&self) -> &dyn Any {
        self.tx.native()
    }
}

/// Context for post-commit hooks and `on_query` enrichment. Hook errors
/// never fail the HTTP response — the command layer logs them.
#[derive(Clone)]
pub struct PostCommitContext {
    conn: Arc<dyn HookConnSource>,
    pub organization_id: Uuid,
    pub correlation_id: Uuid,
    pub api_key_id: Uuid,
    pub entity_id: Uuid,
    pub source: SourceContext,
}

impl PostCommitContext {
    pub fn new(
        conn: Arc<dyn HookConnSource>,
        correlation_id: Uuid,
        organization_id: Uuid,
        api_key_id: Uuid,
        entity_id: Uuid,
        source: SourceContext,
    ) -> Self {
        Self {
            conn,
            organization_id,
            correlation_id,
            api_key_id,
            entity_id,
            source,
        }
    }

    /// Execute raw SQL outside any command transaction.
    pub async fn execute(&self, sql: &str) -> Result<u64, String> {
        self.conn.execute(sql).await
    }

    /// The provider-native connection handle (downcast hatch).
    pub fn native(&self) -> &dyn Any {
        self.conn.native()
    }
}

/// Control-flow outcome of transactional hooks.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum HookControl {
    Continue,
    /// Roll the transaction back; the command layer maps this to a
    /// conflict error.
    Abort { reason: String },
}

/// Convenience alias for hook results.
pub type HookResult = Result<HookControl, crate::error::HookError>;
