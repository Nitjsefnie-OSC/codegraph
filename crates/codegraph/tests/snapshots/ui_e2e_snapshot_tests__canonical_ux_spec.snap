// Generated by codegraph. DO NOT EDIT.
// UX list-rendering E2E tests for Refund (ux-rules epic, #302).




import { test, expect } from '../../e2e/fixtures/personas';
import type { OrgContext } from '../../e2e/fixtures/personas';
import {
  createEntityAsAcme,
  deleteEntityAsAcme,
} from '../../e2e/helpers';

import type { CreateRefundRequest } from '#lib/api/types.ts';

import { RefundPage } from './refund.page';


const BASE_PATH = '/hr/refund';


// Entity reference dependency IDs — populated in beforeAll when FK deps exist

const depIds: Record<string, string | string[]> = {};


let createdIds: string[] = [];

function testData(): Partial<Record<keyof CreateRefundRequest | 'code', unknown>> {
  return {


    'id': `00000000-0000-4000-8000-${Math.random().toString(16).slice(2, 14).padStart(12, '0')}`,



    'name': 'Test Name',



    'status': 'draft',




    'headcount': 42,





    'total_amount': 42.5,




    'due_at': '2026-01-15T08:00:00Z',



    'created_at': '2026-01-15T08:00:00Z',




  };
}

// Create a ux fixture row via the API and register it for teardown.
async function createUxFixture(
  orgContext: OrgContext,
  overrides: Record<string, unknown> = {},
): Promise<string> {
  const entity = await createEntityAsAcme(orgContext, BASE_PATH, { ...testData(), ...overrides });
  const id = entity['id'] as string;
  createdIds.push(id);
  return id;
}

test.describe('Refund UX list rendering', () => {



  test.afterEach(async ({ orgContext }) => {
    for (const id of createdIds) {
      try {
        await deleteEntityAsAcme(orgContext, BASE_PATH, id);
      } catch { /* best effort */ }
    }
    createdIds = [];
  });


  test('list renders the ux table contract', async ({ ownerPage: page, orgContext }) => {
    const ui = new RefundPage(page);
    await createUxFixture(orgContext);
    await ui.openList();
    await expect(ui.tableRoot()).toBeVisible();
    // The header sequence mirrors the plan's column_order — no extra or
    // missing columns. A plan with no resolvable columns renders the
    // id fallback column, so expect exactly that one.
    const headerCount = await ui.headerCount();
    expect(headerCount).toBe(7);

    // The first rendered column is the human-readable field, not the
    // system id (plan rows 17/25).
    {
      const firstCell = ui.firstCell();
      await expect(firstCell).toHaveText('Test Name');
    }

  });



  test('status chips render with the expected labels', async ({ ownerPage: page, orgContext }) => {
    const ui = new RefundPage(page);
    await createUxFixture(orgContext);
    await ui.openList();

    {
      const chip = ui.chipFor('draft');
      await expect(chip).toBeVisible();
      await expect(chip).toHaveText('draft');
    }

  });



  test('numeric columns right-align and format through Intl', async ({ ownerPage: page, orgContext }) => {
    const ui = new RefundPage(page);
    await createUxFixture(orgContext);
    await ui.openList();

    await ui.expectRightAligned(4, 'headcount');

    await ui.expectRightAligned(5, 'total_amount');


    // The default ordering puts the fresh fixture row first; the POM
    // skips the em-dash placeholder (a null cell on that row — the
    // column isn't fixture-controlled for this page).
    await ui.expectFormatted(4, 'quantity', 42);

    // The default ordering puts the fresh fixture row first; the POM
    // skips the em-dash placeholder (a null cell on that row — the
    // column isn't fixture-controlled for this page).
    await ui.expectFormatted(5, 'money', 42.5);

    // The default ordering puts the fresh fixture row first; the POM
    // skips the em-dash placeholder (a null cell on that row — the
    // column isn't fixture-controlled for this page).
    await ui.expectFormatted(6, 'time-point', '2026-01-15T08:00:00Z');

  });



  test('copy-chip copies the identifier and surfaces a tooltip', async ({ ownerPage: page, orgContext }) => {
    const ui = new RefundPage(page);
    const createdId = await createUxFixture(orgContext);
    await ui.openList();
    // The copy cell truncates, so scope to the row carrying the fixture
    // value prefix rather than trusting row order.
    const row = ui.table.rowFor((createdId).slice(0, 8));
    await ui.copyCell(row, createdId);

    // Hover (or focus) surfaces the FULL value through the Tooltip. Radix
    // closes the tooltip on trigger click, and a hover() over an element
    // the pointer already occupies fires no new pointerenter — move the
    // pointer away first so the reopen is deterministic.
    await page.mouse.move(0, 0);
    await ui.copyTrigger(row).hover();
    await expect(ui.tooltipFor(createdId)).toBeVisible();

  });



  test('row actions open the overflow menu', async ({ ownerPage: page, orgContext }) => {
    const ui = new RefundPage(page);
    await createUxFixture(orgContext);
    await ui.openList();
    await ui.openActions();

    // Delete opens the confirmation dialog; CANCEL keeps the row.
    await ui.menuDelete().click();
    const confirm = ui.deleteConfirm();
    await expect(confirm).toBeVisible();
    const rows = ui.table.rows();
    const rowsBefore = await rows.count();
    await confirm.getByRole('button', { name: /cancel/i }).click();
    await expect(confirm).toBeHidden();
    await expect(rows).toHaveCount(rowsBefore);

  });





  test('sortable headers toggle aria-sort and validate ?sort', async ({ ownerPage: page, orgContext }) => {
    // Three full sort navigations over potentially large seeded tables —
    // the 45s project default is too tight under parallel workers.
    test.setTimeout(120_000);
    const ui = new RefundPage(page);
    await createUxFixture(orgContext);
    await ui.openList();

    {
      const th = ui.sortHeader('name');
      const btn = ui.sortButton('name');
      await expect(btn).toBeVisible();
      await expect(th).toHaveAttribute('aria-sort', 'none');
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'ascending');
      await expect(page).toHaveURL(/sort=name(&|$)/);
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'descending');
      await expect(page).toHaveURL(/order=desc(&|$)/);
    }

    {
      const th = ui.sortHeader('headcount');
      const btn = ui.sortButton('headcount');
      await expect(btn).toBeVisible();
      await expect(th).toHaveAttribute('aria-sort', 'none');
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'ascending');
      await expect(page).toHaveURL(/sort=headcount(&|$)/);
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'descending');
      await expect(page).toHaveURL(/order=desc(&|$)/);
    }

    {
      const th = ui.sortHeader('total_amount');
      const btn = ui.sortButton('total_amount');
      await expect(btn).toBeVisible();
      await expect(th).toHaveAttribute('aria-sort', 'none');
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'ascending');
      await expect(page).toHaveURL(/sort=total_amount(&|$)/);
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'descending');
      await expect(page).toHaveURL(/order=desc(&|$)/);
    }

    {
      const th = ui.sortHeader('due_at');
      const btn = ui.sortButton('due_at');
      await expect(btn).toBeVisible();
      await expect(th).toHaveAttribute('aria-sort', 'none');
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'ascending');
      await expect(page).toHaveURL(/sort=due_at(&|$)/);
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'descending');
      await expect(page).toHaveURL(/order=desc(&|$)/);
    }

    {
      const th = ui.sortHeader('created_at');
      const btn = ui.sortButton('created_at');
      await expect(btn).toBeVisible();
      await expect(th).toHaveAttribute('aria-sort', 'none');
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'ascending');
      await expect(page).toHaveURL(/sort=created_at(&|$)/);
      await btn.click();
      await expect(th).toHaveAttribute('aria-sort', 'descending');
      await expect(page).toHaveURL(/order=desc(&|$)/);
    }

    // The rendered header order follows the plan's column_order sequence
    // (readable field first, audit stamps last).
    {
      const headerOrder: number[] = [];

      headerOrder.push(
        await ui.sortHeader('name').evaluate((th) => Array.from(th.parentElement?.children ?? []).indexOf(th))
      );

      headerOrder.push(
        await ui.sortHeader('headcount').evaluate((th) => Array.from(th.parentElement?.children ?? []).indexOf(th))
      );

      headerOrder.push(
        await ui.sortHeader('total_amount').evaluate((th) => Array.from(th.parentElement?.children ?? []).indexOf(th))
      );

      headerOrder.push(
        await ui.sortHeader('due_at').evaluate((th) => Array.from(th.parentElement?.children ?? []).indexOf(th))
      );

      headerOrder.push(
        await ui.sortHeader('created_at').evaluate((th) => Array.from(th.parentElement?.children ?? []).indexOf(th))
      );

      const sortedOrder = [...headerOrder].sort((a, b) => a - b);
      expect(headerOrder).toEqual(sortedOrder);
    }
    // Invalid sort fields are rejected with the allow-list (API-level).
    {
      const baseUrl = process.env.PUBLIC_API_URL ?? 'http://localhost:3000';
      const res = await fetch(`${baseUrl}/api/v1${BASE_PATH}?sort=__nope__`, {
        headers: { 'Authorization': `Bearer ${orgContext.acme.apiKey}` },
      });
      expect(res.status).toBe(400);
      const body = await res.text();
      expect(body).toContain('Unknown sort field');
      expect(body).toContain('name, headcount, total_amount, due_at, created_at');
    }

    // Valid ?sort=&order= flips first-row ordering on two distinct rows.
    // Null placeholder cells (—) are ordering-insensitive and can pin the
    // first row in both directions (nulls + pagination), so the flip is
    // only asserted when both first-row texts are real values.
    {
      await createUxFixture(orgContext);
      await createUxFixture(orgContext, { 'name': 'Test Name B' });
      await ui.openListAt('?sort=name&order=asc');
      const cell = ui.cell(1);
      const asc = ((await cell.textContent()) ?? '').trim();
      await ui.openListAt('?sort=name&order=desc');
      const desc = ((await cell.textContent()) ?? '').trim();
      if (asc !== '\u2014' && desc !== '\u2014' && asc !== '' && desc !== '') {
        expect(desc).not.toBe(asc);
      }
    }

  });



  test('rows keep zebra shading and hover/focus feedback', async ({ ownerPage: page, orgContext }) => {
    const ui = new RefundPage(page);
    await createUxFixture(orgContext);
    await createUxFixture(orgContext);
    await ui.openList();
    await ui.expectZebra();
  });

});
